{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "../../data/product/apps/cli/src",
    "customConditions": [],
    "paths": {
      "@nous-wave/contracts": [
        "../../data/packages/contracts/dist/index.d.ts"
      ],
      "@nous-wave/contracts/*": [
        "../../data/packages/contracts/dist/*.d.ts"
      ],
      "@nous-wave/nous": [
        "../../data/packages/nous/dist/packages/nous/src/index.d.ts"
      ],
      "@nous-wave/client": [
        "../../data/packages/client/dist/index.d.ts"
      ]
