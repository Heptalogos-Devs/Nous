{
  "name": "nous-wave-workspace",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "corepack pnpm run build && node apps/server/dist/main.js",
    "nous": "node apps/cli/dist/main.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "corepack pnpm build && corepack pnpm typecheck && corepack pnpm test",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "generate": "tsc -p packages/contracts/tsconfig.json && tsc -p packages/platform/tsconfig.json && node --import tsx apps/server/src/generate.ts",
    "start": "corepack pnpm --filter @nous-wave/server start",
    "pack": "corepack pnpm --filter \"./packages/**\" -r pack"
  },
  "dependencies": {
    "@nous-wave/contracts": "workspace:*",
    "@nous-wave/nous": "workspace:*",
    "@nous-wave/client": "workspace:*",
    "kysely": "0.29.7",
    "@nous-wave/platform": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "@types/pg": "8.15.5",
    "@types/cacache": "20.0.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "execa": "10.0.1",
    "pg": "8.23.1",
    "zod": "4.6.5"
  }
}
