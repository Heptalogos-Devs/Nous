{
  "name": "nous-wave-workspace",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --conditions=development --import tsx apps/server/src/main.ts",
    "nous": "node --conditions=development --import tsx apps/cli/src/main.ts",
    "test": "node --conditions=development --import tsx --test tests/*.test.ts",
    "check": "corepack pnpm typecheck && corepack pnpm test",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "generate": "node --conditions=development --import tsx apps/server/src/generate.ts",
    "start": "node data/product/apps/server/src/main.js"
  },
  "dependencies": {
    "@nous-wave/contracts": "workspace:*",
    "@nous-wave/nous": "workspace:*",
    "@nous-wave/client": "workspace:*",
    "kysely": "0.29.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "@types/pg": "8.15.5",
    "@types/cacache": "20.0.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
