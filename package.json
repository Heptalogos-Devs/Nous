{
  "name": "nous-wave-workspace",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev/start.ts",
    "nous": "tsx scripts/dev/nous.ts",
    "runtime:pack": "tsx scripts/runtime/pack.ts",
    "assemble:portable": "tsx scripts/release/assemble.ts",
    "format": "prettier --config .config/prettier.json --ignore-path .config/prettierignore \"apps/**/*.{ts,tsx,js,json}\" \"packages/**/*.{ts,tsx,js,json}\" \"scripts/**/*.ts\" \"*.{json,js,cjs,mjs,yml,yaml}\" \".config/*.{ts,json,cjs,yaml}\" \"proto/*.yaml\" --write",
    "format:check": "prettier --config .config/prettier.json --ignore-path .config/prettierignore \"apps/**/*.{ts,tsx,js,json}\" \"packages/**/*.{ts,tsx,js,json}\" \"scripts/**/*.ts\" \"*.{json,js,cjs,mjs,yml,yaml}\" \".config/*.{ts,json,cjs,yaml}\" \"proto/*.yaml\" --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config .config/vitest.ts",
    "generate": "buf generate --template .config/buf.gen.yaml",
    "proto:check": "buf lint proto",
    "lint:ts": "oxlint --config .config/oxlint.json --ignore-pattern \"**/generated/**\" --type-aware --deny-warnings --report-unused-disable-directives",
    "lint:knip": "knip --config .config/knip.json --strict",
    "lint:deps": "dependency-cruiser apps/nous-core/src packages --config .config/dependencies.cjs",
    "lint:dupes": "jscpd --config .config/duplication.json",
    "lint:sherif": "sherif",
    "check": "pnpm check:fast && pnpm test",
    "research:gateway": "tsx scripts/research/serve-gateway.ts",
    "release:notices": "tsx scripts/release/prepare-notices.ts",
    "release:verify": "tsx scripts/release/verify-portable.ts",
    "release:archive": "tsx scripts/release/archive.ts",
    "dev:prepare": "tsx scripts/dev/prepare.ts",
    "check:length": "tsx scripts/dev/check-code-length.ts",
    "check:fast": "pnpm check:length && pnpm format:check && pnpm proto:check && pnpm typecheck && pnpm lint:ts",
    "audit": "pnpm lint:knip && pnpm lint:deps && pnpm lint:sherif && pnpm lint:dupes",
    "smoke:memory": "tsx scripts/smoke/memory.ts",
    "smoke:longitudinal": "tsx scripts/smoke/longitudinal.ts",
    "smoke:runtime": "tsx scripts/smoke/runtime-episode.ts",
    "smoke:model": "tsx scripts/smoke/model-material-resource.ts",
    "smoke:media": "tsx scripts/smoke/media-routes.ts",
    "smoke": "pnpm smoke:memory && pnpm smoke:runtime && pnpm smoke:model && pnpm smoke:media && pnpm smoke:longitudinal && pnpm smoke:configuration",
    "research:longitudinal": "tsx scripts/research/longitudinal.ts",
    "research:media-live": "tsx scripts/research/media.ts",
    "dev:portable": "tsx scripts/dev/portable.ts",
    "smoke:configuration": "tsx scripts/smoke/configuration.ts",
    "inspect:model-contracts": "tsx scripts/research/model-contracts.ts",
    "inspect:model-trace": "tsx scripts/research/model-trace.ts"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@swc/core": "1.16.2",
    "@types/node": "24.19.1",
    "@types/yauzl": "3.4.0",
    "dependency-cruiser": "18.4.0",
    "jscpd": "5.3.2",
    "knip": "6.38.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "sherif": "1.13.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@nous-wave/client": "workspace:*",
    "@nous-wave/protocol": "workspace:*",
    "esbuild": "0.28.2",
    "smol-toml": "1.9.0",
    "zod": "4.6.5"
  }
}
