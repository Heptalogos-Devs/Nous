{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/dev/*.ts!",
        "scripts/runtime/pack.ts!",
        "scripts/openclaw/{prepare,pack}.ts!",
        "scripts/maintenance/clean.ts!",
        "scripts/release/{assemble,archive,prepare-notices,verify-portable,client,verify-client}.ts!",
        "scripts/smoke/{memory,runtime-episode,model-material-resource,media-routes,longitudinal,configuration,openclaw,openclaw-self,self,self-model,self-history,client}.ts!",
        "scripts/research/{media,serve-gateway,longitudinal,model-contracts,model-trace,dogfooding}.ts!",
        "scripts/tests/**/*.test.ts",
        "scripts/tests/release/client-consumer.ts!"
      ]
    },
    "packages/openclaw": {
      "entry": ["src/index.ts!", "bin/{prepare,install}.mjs!"],
      "project": ["src/**/*.ts!", "bin/*.mjs!"],
      "ignoreDependencies": ["openclaw"]
    },
    "apps/nous-core": {
      "entry": ["src/main.ts!", "src/launcher.ts!", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts"],
      "ignoreExportsUsedInFile": {
        "class": true,
        "function": true
      }
    },
    "apps/nous-cli": {
      "entry": ["src/main.ts!", "src/mcp-main.ts!", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts"]
    }
  },
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "enumMembers": "error",
    "namespaceMembers": "error",
    "duplicates": "error",
    "cycles": "error"
  },
  "ignoreBinaries": ["tsx"]
}
