{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/dev/*.ts!",
        "scripts/runtime/pack.ts!",
        "scripts/openclaw/{prepare,pack}.ts!",
        "scripts/maintenance/clean.ts!",
        "scripts/release/{assemble,archive,prepare-notices,verify-portable,client,verify-client}.ts!",
        "scripts/smoke/{longitudinal,animated-media}.ts!",
        "scripts/research/{media,serve-gateway,longitudinal,model-contracts,model-trace,dogfooding}.ts!",
        "scripts/tests/**/*.test.ts",
        "scripts/tests/release/client-consumer.ts!",
        "scripts/tests/openclaw/custody.ts!",
        "scripts/tests/openclaw/local-plugin-probe.ts!"
      ]
    },
    "packages/client": {
      "entry": [
        "src/{index,node,managed,errors}.ts!",
        "src/policy/{consumer,execution}.ts!",
        "tests/**/*.test.ts",
        "tests/clock-transport.ts!",
        "src/motivation.ts!",
        "tests/motivation-transport.ts!",
        "tests/motivation-semantic-transport.ts!"
      ]
    },
    "packages/openclaw": {
      "entry": [
        "src/index.ts!",
        "bin/{prepare,install,controlled-plugin}.mjs!"
      ],
      "project": ["src/**/*.ts!", "bin/*.mjs!"],
      "ignoreDependencies": ["openclaw"]
    },
    "apps/nous-core": {
      "entry": ["src/main.ts!", "src/launcher.ts!", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts"],
      "ignoreExportsUsedInFile": {
        "class": true,
        "function": true
      }
    },
    "apps/nous-cli": {
      "entry": ["src/main.ts!", "src/mcp-main.ts!", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts!", "tests/**/*.ts"]
    }
  },
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "enumMembers": "error",
    "namespaceMembers": "error",
    "duplicates": "error",
    "cycles": "error"
  },
  "ignoreBinaries": ["tsx"]
}
