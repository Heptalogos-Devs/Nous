{
  "path": ["../apps", "../packages", "../crates", "../scripts"],
  "minLines": 6,
  "minTokens": 50,
  "threshold": 5,
  "gitignore": true,
  "mode": "mild",
  "reporters": ["console"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.nx/**",
    "**/generated/**",
    "**/*.generated.*",
    "data/**"
  ]
}
