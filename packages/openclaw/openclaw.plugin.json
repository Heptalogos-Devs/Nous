{
  "id": "nous-cognition",
  "name": "Nous Cognition",
  "description": "Managed Subject cognition at every native OpenClaw model invocation.",
  "kind": "context-engine",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["runRoot", "subjectId", "consumerId"],
    "properties": {
      "runRoot": {
        "type": "string",
        "minLength": 1
      },
      "subjectId": {
        "type": "string",
        "format": "uuid"
      },
      "consumerId": {
        "type": "string",
        "minLength": 1
      },
      "workContextId": {
        "type": "string",
        "format": "uuid"
      },
      "cognitionTokenCap": {
        "type": "integer",
        "minimum": 512,
        "default": 4096
      },
      "hostBridge": {
        "type": "object",
        "additionalProperties": false,
        "required": ["origin", "credentialFile"],
        "properties": {
          "origin": {
            "type": "string",
            "format": "uri"
          },
          "credentialFile": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "sourceRead": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "currentConversation": {
            "type": "boolean",
            "default": false
          },
          "sourceRefs": {
            "type": "array",
            "maxItems": 1024,
            "items": {
              "type": "object",
              "required": ["kind", "value"],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "originConversationRefs": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "routes": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "required": ["conversationRef"],
              "additionalProperties": false,
              "properties": {
                "conversationRef": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceRefs": {
                  "type": "array",
                  "maxItems": 1024,
                  "items": {
                    "type": "object",
                    "required": ["kind", "value"],
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    }
                  }
                },
                "originConversationRefs": {
                  "type": "array",
                  "maxItems": 64,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                }
              }
            }
          }
        }
      },
      "materialInputs": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxItems": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128,
            "default": 8
          },
          "maxTextBytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 1048576,
            "default": 65536
          }
        }
      }
    }
  },
  "contracts": {
    "tools": ["nous_query", "nous_read"]
  }
}
