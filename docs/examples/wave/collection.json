  "concepts": [
    {
      "key": "cancellation",
      "label": "取消等待",
      "description": "调用者停止等待一项异步操作；实际线程或外部计算可能仍然运行。",
      "aliases": [
        "任务取消"
      ]
    },
    {
      "key": "resource-ownership",
      "label": "资源所有权",
      "description": "决定由谁持有、使用和释放文件、连接、计算资产以及它们真实生命周期的职责。"
    },
    {
      "key": "transaction",
      "label": "数据库事务",
      "description": "把完整业务操作的正式数据变化一起提交或回滚的短期边界。"
    },
    {
      "key": "provenance",
      "label": "来源追踪",
      "description": "保留资料的原始来源、派生处理和精确引用；区分重复派生与独立证据。"
    },
    {
      "key": "counterevidence",
      "label": "反证",
      "description": "与已有判断冲突且具有自身来源的材料，需要独立呈现其内容及依据。"
    },
    {
      "key": "repeat-as-evidence",
      "label": "重复派生视为独立证据",
      "description": "一种将同源材料多次总结分别计为独立支持的主张；示例保留它用于与来源独立性原则对照。"
    }
  ],
