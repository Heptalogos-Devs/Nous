	rerank [label="Core可选模型rerank
intent、profile、候选≥2" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/crates/runtime/src/query/ranking.rs" color="#2e527b" fillcolor="#e9f0fb" shape=box tooltip="Nous Wave · rerank"]
	resource [label="Core外部资源动作
adapter search / version / access" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/apps/nous-core/src/resources/adapter.ts" color="#2e527b" fillcolor="#e9f0fb" shape=box tooltip="Nous Wave · resource"]
	adapter [label="宿主实际Resource provider
缺失时unavailable" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/apps/nous-core/src/resources/adapter.ts" color="#535c69" fillcolor="#f3f4f6" shape=ellipse style=filled tooltip="外部主体或服务 · resource"]
	final [label="finalizeQuery
按ticket校验、采用排序与外部结果" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/crates/runtime/src/query/bind.rs" color="#2e527b" fillcolor="#e9f0fb" shape=box tooltip="Nous Wave · query, rerank, resource"]
	response [label="QueryResult
正文 / 来源 / 时间 / 状态
Partial / Degraded与继续引用" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/crates/runtime/src/query/bind.rs" color="#2e527b" fillcolor="#e9f0fb" shape=box tooltip="Nous Wave · query"]
	feedback [label="Query反馈
后续ReportUse另行记录" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/crates/memory/src/service/accessibility.rs" color="#2e527b" fillcolor="#e9f0fb" peripheries=2 shape=box tooltip="Nous Wave · accessibility"]
	historical [label="历史Authority / Serving view
as_of、history、world knowledge cutoff" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/crates/runtime/src/subject_clock.rs" color="#2e527b" fillcolor="#e9f0fb" peripheries=2 shape=box tooltip="Nous Wave · time, serving"]
	text -> parse [label="提交完整查询" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/apps/nous-core/src/nousql/parser.ts" color="#596575" penwidth=1.3 style=solid tooltip="运行时调用或请求 · 提交完整查询"]
	parse -> bind [label=QueryRequest URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/apps/nous-core/src/nousql/parser.ts" color="#245c9a" penwidth=1.4 style=solid tooltip="将材料、候选或结果送往后续节点 · QueryRequest"]
	bind -> exact [label="冻结的查询性质" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/crates/runtime/src/query/bind.rs" color="#245c9a" penwidth=1.4 style=solid tooltip="将材料、候选或结果送往后续节点 · 冻结的查询性质"]
