// 认知查询、共享检索与最终返回
digraph query {
	graph [bgcolor="#ffffff" fontcolor="#202e3a" fontname="Noto Sans CJK SC" fontsize=18 label="认知查询、共享检索与最终返回" labeljust=l labelloc=t newrank=true nodesep=0.38 outputorder=edgesfirst pad=0.3 rankdir=TB ranksep=1.15 splines=spline]
	node [fontname="Noto Sans CJK SC" fontsize=11.5 margin="0.20,0.12" penwidth=1.3 style="rounded,filled"]
	edge [arrowsize=0.7 fontcolor="#334155" fontname="Noto Sans CJK SC" fontsize=9.3]
	text [label="用户 / Agent 查询
自然文本 + 可选语法岛" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/apps/nous-core/src/nousql/parser.ts" color="#535c69" fillcolor="#f3f4f6" shape=ellipse style=filled tooltip="外部主体或服务 · nql"]
	parse [label="Chevrotain解析 / 编译
意图、selector、时间与结果要求" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/apps/nous-core/src/nousql/parser.ts" color="#2e527b" fillcolor="#e9f0fb" shape=box tooltip="Nous Wave · nql"]
	bind [label="prepareQuery
身份绑定、WorkContext、权限、域时间
配置与QueryPlan冻结" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/crates/runtime/src/query/bind.rs" color="#2e527b" fillcolor="#e9f0fb" shape=box tooltip="Nous Wave · query, address, time"]
	exact [label="精确读取？" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/crates/runtime/src/query/bind.rs" color="#2e527b" fillcolor="#e9f0fb" shape=diamond style=filled tooltip="Nous Wave · query"]
	hostmodel [label="可选Host准备
query embedding / concept enrichment" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/crates/runtime/src/query/bind.rs" color="#2e527b" fillcolor="#e9f0fb" shape=box tooltip="Nous Wave · query, models"]
	shared [label="共享Serving候选
lexical / dense / Tag / 可选topology" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/crates/runtime/src/query/bind.rs" color="#2e527b" fillcolor="#e9f0fb" shape=box tooltip="Nous Wave · query, indexes, topology"]
	lexical [label="Tantivy
结构过滤与词项候选" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/crates/retrieval/Cargo.toml" color="#2e527b" fillcolor="#e9f0fb" peripheries=2 shape=box tooltip="Nous Wave · indexes"]
	dense [label="USearch + RoaringBitmap
获准候选集合中的向量搜索" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/crates/retrieval/Cargo.toml" color="#2e527b" fillcolor="#e9f0fb" peripheries=2 shape=box tooltip="Nous Wave · indexes"]
	topo [label="默认关闭的拓扑lane
EPA / Residual / Wave / VCP" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/crates/retrieval/src/vcp/lane.rs" color="#2e527b" fillcolor="#e9f0fb" shape=box tooltip="Nous Wave · topology"]
	direct [label="领域direct lanes + Runtime
精确绑定、当前resident及anchors" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/crates/runtime/src/query/bind.rs" color="#2e527b" fillcolor="#e9f0fb" shape=box tooltip="Nous Wave · query, workcontext"]
	fusion [label="Runtime合并与固定融合
对象revision去重、lane预算" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/crates/runtime/src/query/bind.rs" color="#2e527b" fillcolor="#e9f0fb" shape=box tooltip="Nous Wave · query"]
	owner [label="按owner批量核验并物化
当前可用性、来源权限、时间与清除" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/crates/runtime/src/query/bind.rs" color="#2e527b" fillcolor="#e9f0fb" shape=box tooltip="Nous Wave · query, lifecycle"]
	pool [label="已核验候选 + validation ticket
