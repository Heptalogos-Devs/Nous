	shared -> topo [label="显式启用且有预算" URL="https://github.com/Heptalogos-Devs/Nous-Wave/blob/412b062082afb75ccfae4c3f69fc606d3e3cc862/crates/retrieval/src/vcp/lane.rs" color="#596575" penwidth=1.3 style=solid tooltip="运行时调用或请求 · 显式启用且有预算"]
