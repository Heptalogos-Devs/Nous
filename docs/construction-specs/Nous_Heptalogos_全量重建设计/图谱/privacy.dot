consume [label="新 ContextView / 查询结果",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/部署可移植性与清除.md#清除的完整操作",tooltip="新 ContextView / 查询结果：见设计/部署可移植性与清除.md"];
remove [label="明确的 remove 请求",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/部署可移植性与清除.md#清除的完整操作",tooltip="明确的 remove 请求：见设计/部署可移植性与清除.md"];
tx [label="cognition.remove\n当前状态与任务",shape=box,style="filled",fillcolor="#eef7f4",URL="../设计/部署可移植性与清除.md#清除的完整操作",tooltip="cognition.remove\n当前状态与任务：见设计/部署可移植性与清除.md"];
state [label="当前清除 / 可用状态",shape=cylinder,style="filled",fillcolor="#e8f0f3",URL="../设计/部署可移植性与清除.md#清除的完整操作",tooltip="当前清除 / 可用状态：见设计/部署可移植性与清除.md"];
jobs [label="清理作业",shape=hexagon,style="filled",fillcolor="#efedf6",URL="../设计/部署可移植性与清除.md#清除的完整操作",tooltip="清理作业：见设计/部署可移植性与清除.md"];
search [label="搜索 / 缓存 / 派生",shape=cylinder,style="filled",fillcolor="#e8f0f3",URL="../设计/部署可移植性与清除.md#清除的完整操作",tooltip="搜索 / 缓存 / 派生：见设计/部署可移植性与清除.md"];
blob [label="无其他合法引用的字节",shape=cylinder,style="filled",fillcolor="#e8f0f3",URL="../设计/部署可移植性与清除.md#清除的完整操作",tooltip="无其他合法引用的字节：见设计/部署可移植性与清除.md"];
native [label="相关原生 Session 重建",shape=box,style="filled",fillcolor="#eef7f4",URL="../设计/部署可移植性与清除.md#清除的完整操作",tooltip="相关原生 Session 重建：见设计/部署可移植性与清除.md"];
backup [label="备份清除清单 / 保留期限",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/部署可移植性与清除.md#清除的完整操作",tooltip="备份清除清单 / 保留期限：见设计/部署可移植性与清除.md"];
context -> query [label="实际访问范围",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；实际访问范围"];
source -> query [label="披露策略桶",style="dotted",color="#65717d",fontcolor="#65717d",arrowhead=vee,constraint=true,tooltip="引用：源对象引用目标身份或资料；不表示执行；披露策略桶"];
query -> read [label="有界候选",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；有界候选"];
state -> read [label="当前删除与权限",style="dotted",color="#65717d",fontcolor="#65717d",arrowhead=vee,constraint=true,tooltip="引用：源对象引用目标身份或资料；不表示执行；当前删除与权限"];
read -> consume [label="完整获准内容",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；完整获准内容"];
remove -> tx [label="选择对象/来源/主体范围",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；选择对象/来源/主体范围"];
tx -> state [label="即时限制新消费",style="bold",color="#19705c",fontcolor="#19705c",arrowhead=normal,constraint=true,tooltip="提交：在标注事务中写入正式状态；即时限制新消费"];
tx -> jobs [label="同事务安排清理",style="dashed",color="#a26416",fontcolor="#a26416",arrowhead=normal,constraint=true,tooltip="交接：事件或持久工作使后续能力获得机会；同事务安排清理"];
jobs -> search [label="删除派生引用",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；删除派生引用"];
jobs -> blob [label="回收没有保留用途的字节",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；回收没有保留用途的字节"];
jobs -> native [label="清除受影响历史",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；清除受影响历史"];
tx -> backup [label="恢复时先应用清除范围",style="bold",color="#19705c",fontcolor="#19705c",arrowhead=normal,constraint=true,tooltip="提交：在标注事务中写入正式状态；恢复时先应用清除范围"];
native -> consume [label="从保留工作重新组装",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；从保留工作重新组装"];
}