digraph target {
graph [rankdir=TB, fontname="Noto Sans CJK SC", fontsize=17, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.65", splines=polyline, label="披露、当前消费与清除 · 目标设计", labelloc=t];
node [fontname="Noto Sans CJK SC",fontsize=11,color="#77818b",margin="0.17,0.10",penwidth=1.0];
edge [fontname="Noto Sans CJK SC",fontsize=9,arrowsize=0.7,penwidth=1.1];
context [label="AccessContext\n主体 / 用途 / 听众",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/部署可移植性与清除.md#清除的完整操作",tooltip="AccessContext\n主体 / 用途 / 听众：见设计/部署可移植性与清除.md"];
source [label="来源披露政策",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/部署可移植性与清除.md#清除的完整操作",tooltip="来源披露政策：见设计/部署可移植性与清除.md"];
query [label="候选前置过滤",shape=box,style="filled",fillcolor="#eef7f4",URL="../设计/部署可移植性与清除.md#清除的完整操作",tooltip="候选前置过滤：见设计/部署可移植性与清除.md"];
