reactor [label="Reactor 单前台",shape=box,style="rounded,filled",fillcolor="#e9eef4",URL="../设计/注意Reactor与生活状态.md#个体化注意",tooltip="Reactor 单前台：见设计/注意Reactor与生活状态.md"];
