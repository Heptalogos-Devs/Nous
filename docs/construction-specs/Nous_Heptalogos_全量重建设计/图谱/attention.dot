digraph target {
graph [rankdir=TB, fontname="Noto Sans CJK SC", fontsize=17, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.65", splines=polyline, label="个体化注意与单前台 · 目标设计", labelloc=t];
node [fontname="Noto Sans CJK SC",fontsize=11,color="#77818b",margin="0.17,0.10",penwidth=1.0];
edge [fontname="Noto Sans CJK SC",fontsize=9,arrowsize=0.7,penwidth=1.1];
sources [label="消息 / 世界 / 任务 / 关切",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/注意Reactor与生活状态.md#个体化注意",tooltip="消息 / 世界 / 任务 / 关切：见设计/注意Reactor与生活状态.md"];
