prepare -> view [label="适用认知",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；适用认知"];
view -> assemble [label="语义单元",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；语义单元"];
material -> assemble [label="当前材料与来源",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；当前材料与来源"];
assemble -> fit [label="实际输入与预算",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；实际输入与预算"];
fit -> failure [label="否",style="solid",color="#805497",fontcolor="#805497",arrowhead=normal,constraint=true,tooltip="状态：标注条件成立时发生业务状态转换；否"];
fit -> model [label="是：执行",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；是：执行"];
model -> accepted [label="真实终态",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；真实终态"];
accepted -> partial [label="否",style="solid",color="#805497",fontcolor="#805497",arrowhead=normal,constraint=true,tooltip="状态：标注条件成立时发生业务状态转换；否"];
accepted -> turn [label="是：正式提交回合",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；是：正式提交回合"];
turn -> outbox [label="原生保留交接身份",style="bold",color="#19705c",fontcolor="#19705c",arrowhead=normal,constraint=true,tooltip="提交：在标注事务中写入正式状态；原生保留交接身份"];
outbox -> record [label="稳定身份投递",style="dashed",color="#a26416",fontcolor="#a26416",arrowhead=normal,constraint=true,tooltip="交接：事件或持久工作使后续能力获得机会；稳定身份投递"];
record -> db [label="幂等接触与经历",style="bold",color="#19705c",fontcolor="#19705c",arrowhead=normal,constraint=true,tooltip="提交：在标注事务中写入正式状态；幂等接触与经历"];
db -> growth [label="成长工作",style="dashed",color="#a26416",fontcolor="#a26416",arrowhead=normal,constraint=true,tooltip="交接：事件或持久工作使后续能力获得机会；成长工作"];
partial -> material [label="后续可以实际再读取",style="dotted",color="#65717d",fontcolor="#65717d",arrowhead=vee,constraint=true,tooltip="引用：源对象引用目标身份或资料；不表示执行；后续可以实际再读取"];
}