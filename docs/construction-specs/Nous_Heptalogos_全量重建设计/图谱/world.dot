digraph target {
graph [rankdir=TB, fontname="Noto Sans CJK SC", fontsize=17, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.65", splines=polyline, label="世界、时间与实际生活 · 目标设计", labelloc=t];
node [fontname="Noto Sans CJK SC",fontsize=11,color="#77818b",margin="0.17,0.10",penwidth=1.0];
edge [fontname="Noto Sans CJK SC",fontsize=9,arrowsize=0.7,penwidth=1.1];
subgraph cluster_0 { label="世界事务"; style="rounded,dashed"; color="#b6c4cb"; fontsize=12;
advance [label="world.advance\n完成实际经过区间",shape=box,style="filled",fillcolor="#eef7f4",URL="../设计/世界日历与人物.md#从长期设定到具体生活",tooltip="world.advance\n完成实际经过区间：见设计/世界日历与人物.md"];
event [label="RealizedEvent",shape=cylinder,style="filled",fillcolor="#e8f0f3",URL="../设计/世界日历与人物.md#从长期设定到具体生活",tooltip="RealizedEvent：见设计/世界日历与人物.md"];
state [label="地点 / 参加 / 精力状态",shape=cylinder,style="filled",fillcolor="#e8f0f3",URL="../设计/世界日历与人物.md#从长期设定到具体生活",tooltip="地点 / 参加 / 精力状态：见设计/世界日历与人物.md"];
}
setting [label="WorldDefinition / Profile",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/世界日历与人物.md#从长期设定到具体生活",tooltip="WorldDefinition / Profile：见设计/世界日历与人物.md"];
clock [label="ClockMapping\n现实锚点→世界点",shape=box,style="rounded,filled",fillcolor="#e9eef4",URL="../设计/世界日历与人物.md#从长期设定到具体生活",tooltip="ClockMapping\n现实锚点→世界点：见设计/世界日历与人物.md"];
calendar [label="Calendar\n规则 / 例外 / 未来计划",shape=box,style="rounded,filled",fillcolor="#e9eef4",URL="../设计/世界日历与人物.md#从长期设定到具体生活",tooltip="Calendar\n规则 / 例外 / 未来计划：见设计/世界日历与人物.md"];
planner [label="WorldPlanner\n作者视角",shape=hexagon,style="filled",fillcolor="#efedf6",URL="../设计/世界日历与人物.md#从长期设定到具体生活",tooltip="WorldPlanner\n作者视角：见设计/世界日历与人物.md"];
actors [label="Actor / Object / Affordance",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/世界日历与人物.md#从长期设定到具体生活",tooltip="Actor / Object / Affordance：见设计/世界日历与人物.md"];
adopt [label="已采用 WorldAction",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/世界日历与人物.md#从长期设定到具体生活",tooltip="已采用 WorldAction：见设计/世界日历与人物.md"];
visible [label="按角色派生 Perception",shape=box,style="filled",fillcolor="#eef7f4",URL="../设计/世界日历与人物.md#从长期设定到具体生活",tooltip="按角色派生 Perception：见设计/世界日历与人物.md"];
subject [label="主体后续实际读取",shape=box,style="filled",fillcolor="#eef7f4",URL="../设计/世界日历与人物.md#从长期设定到具体生活",tooltip="主体后续实际读取：见设计/世界日历与人物.md"];
n [label="Nous Encounter",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/世界日历与人物.md#从长期设定到具体生活",tooltip="Nous Encounter：见设计/世界日历与人物.md"];
wake [label="下个实际自然节点",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/世界日历与人物.md#从长期设定到具体生活",tooltip="下个实际自然节点：见设计/世界日历与人物.md"];
setting -> calendar [label="既有规律",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；既有规律"];
setting -> actors [label="角色与环境定义",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；角色与环境定义"];
calendar -> planner [label="有限近期安排",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；有限近期安排"];
actors -> planner [label="作者可知状态",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；作者可知状态"];
planner -> calendar [label="采用后形成计划",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；采用后形成计划"];
clock -> advance [label="当前世界点",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；当前世界点"];
calendar -> advance [label="已到期规则",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；已到期规则"];
adopt -> advance [label="实际动作与已走区间",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；实际动作与已走区间"];
advance -> event [label="生活事实",style="bold",color="#19705c",fontcolor="#19705c",arrowhead=normal,constraint=true,tooltip="提交：在标注事务中写入正式状态；生活事实"];
advance -> state [label="同事务后果",style="bold",color="#19705c",fontcolor="#19705c",arrowhead=normal,constraint=true,tooltip="提交：在标注事务中写入正式状态；同事务后果"];
event -> visible [label="可见事件",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；可见事件"];
actors -> visible [label="该角色知情范围",style="dotted",color="#65717d",fontcolor="#65717d",arrowhead=vee,constraint=true,tooltip="引用：源对象引用目标身份或资料；不表示执行；该角色知情范围"];
visible -> subject [label="实际可阅读内容",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；实际可阅读内容"];
subject -> n [label="接受回合后接触",style="dashed",color="#a26416",fontcolor="#a26416",arrowhead=normal,constraint=true,tooltip="交接：事件或持久工作使后续能力获得机会；接受回合后接触"];
advance -> wake [label="下一结束/日历节点",style="dashed",color="#a26416",fontcolor="#a26416",arrowhead=normal,constraint=true,tooltip="交接：事件或持久工作使后续能力获得机会；下一结束/日历节点"];
wake -> advance [label="时刻到达后推进",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；时刻到达后推进"];
}