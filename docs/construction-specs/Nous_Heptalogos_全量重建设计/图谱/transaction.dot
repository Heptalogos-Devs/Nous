digraph target {
graph [rankdir=TB, fontname="Noto Sans CJK SC", fontsize=17, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.65", splines=polyline, label="完整业务操作与一次提交 · 目标设计", labelloc=t];
node [fontname="Noto Sans CJK SC",fontsize=11,color="#77818b",margin="0.17,0.10",penwidth=1.0];
edge [fontname="Noto Sans CJK SC",fontsize=9,arrowsize=0.7,penwidth=1.1];
subgraph cluster_0 { label="原子提交"; style="rounded,dashed"; color="#b6c4cb"; fontsize=12;
tx [label="同一 Kysely 事务\n应用领域规则",shape=box,style="filled",fillcolor="#eef7f4",URL="../设计/业务操作与事务中心.md#一次业务意图一处提交",tooltip="同一 Kysely 事务\n应用领域规则：见设计/业务操作与事务中心.md"];
rows [label="领域对象与必要修订",shape=cylinder,style="filled",fillcolor="#e8f0f3",URL="../设计/业务操作与事务中心.md#一次业务意图一处提交",tooltip="领域对象与必要修订：见设计/业务操作与事务中心.md"];
jobs [label="pg-boss任务\nfromKysely(tx)",shape=cylinder,style="filled",fillcolor="#e8f0f3",URL="../设计/业务操作与事务中心.md#一次业务意图一处提交",tooltip="pg-boss任务\nfromKysely(tx)：见设计/业务操作与事务中心.md"];
}
request [label="完整业务意图",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/业务操作与事务中心.md#一次业务意图一处提交",tooltip="完整业务意图：见设计/业务操作与事务中心.md"];
command [label="应用操作\n绑定身份与输入",shape=box,style="filled",fillcolor="#eef7f4",URL="../设计/业务操作与事务中心.md#一次业务意图一处提交",tooltip="应用操作\n绑定身份与输入：见设计/业务操作与事务中心.md"];
basis [label="所需领域只读视图",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/业务操作与事务中心.md#一次业务意图一处提交",tooltip="所需领域只读视图：见设计/业务操作与事务中心.md"];
model [label="需要语义生成？",shape=diamond,style="filled",fillcolor="#fff0d9",URL="../设计/业务操作与事务中心.md#一次业务意图一处提交",tooltip="需要语义生成？：见设计/业务操作与事务中心.md"];
provider [label="模型 / 外部读取",shape=hexagon,style="filled",fillcolor="#efedf6",URL="../设计/业务操作与事务中心.md#一次业务意图一处提交",tooltip="模型 / 外部读取：见设计/业务操作与事务中心.md"];
saved [label="保留成果",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/业务操作与事务中心.md#一次业务意图一处提交",tooltip="保留成果：见设计/业务操作与事务中心.md"];
result [label="完整业务结果",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/业务操作与事务中心.md#一次业务意图一处提交",tooltip="完整业务结果：见设计/业务操作与事务中心.md"];
worker [label="框架worker",shape=hexagon,style="filled",fillcolor="#efedf6",URL="../设计/业务操作与事务中心.md#一次业务意图一处提交",tooltip="框架worker：见设计/业务操作与事务中心.md"];
request -> command [label="提交意图",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；提交意图"];
command -> basis [label="一次取得所需输入",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；一次取得所需输入"];
basis -> model [label="固定实际读取版本",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；固定实际读取版本"];
model -> provider [label="需要：生成/读取",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；需要：生成/读取"];
provider -> saved [label="真实成果",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；真实成果"];
saved -> tx [label="采用成果",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；采用成果"];
model -> tx [label="无需：直接应用",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；无需：直接应用"];
tx -> rows [label="业务事实",style="bold",color="#19705c",fontcolor="#19705c",arrowhead=normal,constraint=true,tooltip="提交：在标注事务中写入正式状态；业务事实"];
tx -> jobs [label="后续工作义务",style="bold",color="#19705c",fontcolor="#19705c",arrowhead=normal,constraint=true,tooltip="提交：在标注事务中写入正式状态；后续工作义务"];
rows -> result [label="本次提交结果",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；本次提交结果"];
jobs -> worker [label="提交后执行",style="dashed",color="#a26416",fontcolor="#a26416",arrowhead=normal,constraint=true,tooltip="交接：事件或持久工作使后续能力获得机会；提交后执行"];
worker -> command [label="同一业务身份继续",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=false,tooltip="调用：源节点请求目标完成标注操作；同一业务身份继续"];
}