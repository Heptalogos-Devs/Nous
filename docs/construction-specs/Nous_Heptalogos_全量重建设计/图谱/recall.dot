digraph target {
graph [rankdir=TB, fontname="Noto Sans CJK SC", fontsize=17, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.65", splines=polyline, label="召回、历史与搜索投影 · 目标设计", labelloc=t];
node [fontname="Noto Sans CJK SC",fontsize=11,color="#77818b",margin="0.17,0.10",penwidth=1.0];
edge [fontname="Noto Sans CJK SC",fontsize=9,arrowsize=0.7,penwidth=1.1];
intent [label="自然语言 / 语法岛 / 短引用",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/召回与NousQL.md#候选与排序",tooltip="自然语言 / 语法岛 / 短引用：见设计/召回与NousQL.md"];
bind [label="意图与指代绑定",shape=box,style="filled",fillcolor="#eef7f4",URL="../设计/召回与NousQL.md#候选与排序",tooltip="意图与指代绑定：见设计/召回与NousQL.md"];
plan [label="一个 QueryPlan\n时间 / 用途 / 预算",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/召回与NousQL.md#候选与排序",tooltip="一个 QueryPlan\n时间 / 用途 / 预算：见设计/召回与NousQL.md"];
exact [label="精确 / 结构化 / 当前材料",shape=box,style="filled",fillcolor="#eef7f4",URL="../设计/召回与NousQL.md#候选与排序",tooltip="精确 / 结构化 / 当前材料：见设计/召回与NousQL.md"];
index [label="LanceDB\n全文 + 向量",shape=hexagon,style="filled",fillcolor="#efedf6",URL="../设计/召回与NousQL.md#候选与排序",tooltip="LanceDB\n全文 + 向量：见设计/召回与NousQL.md"];
topo [label="可选图 / VCP策略",shape=box,style="rounded,filled",fillcolor="#e9eef4",URL="../设计/召回与NousQL.md#候选与排序",tooltip="可选图 / VCP策略：见设计/召回与NousQL.md"];
fusion [label="按修订聚合\n一次融合排序",shape=box,style="filled",fillcolor="#eef7f4",URL="../设计/召回与NousQL.md#候选与排序",tooltip="按修订聚合\n一次融合排序：见设计/召回与NousQL.md"];
owners [label="领域批量 read\n当前许可 / 清除 / 时间",shape=box,style="filled",fillcolor="#eef7f4",URL="../设计/召回与NousQL.md#候选与排序",tooltip="领域批量 read\n当前许可 / 清除 / 时间：见设计/召回与NousQL.md"];
rank [label="可选模型rerank",shape=box,style="filled",fillcolor="#eef7f4",URL="../设计/召回与NousQL.md#候选与排序",tooltip="可选模型rerank：见设计/召回与NousQL.md"];
result [label="可读 QueryResult\n来源 / 时间 / result:N",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/召回与NousQL.md#候选与排序",tooltip="可读 QueryResult\n来源 / 时间 / result:N：见设计/召回与NousQL.md"];
write [label="正式认知变更",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/召回与NousQL.md#候选与排序",tooltip="正式认知变更：见设计/召回与NousQL.md"];
job [label="索引更新作业",shape=box,style="filled",fillcolor="#eef7f4",URL="../设计/召回与NousQL.md#候选与排序",tooltip="索引更新作业：见设计/召回与NousQL.md"];
store [label="权威对象与修订",shape=cylinder,style="filled",fillcolor="#e8f0f3",URL="../设计/召回与NousQL.md#候选与排序",tooltip="权威对象与修订：见设计/召回与NousQL.md"];
more [label="资源连接器",shape=hexagon,style="filled",fillcolor="#efedf6",URL="../设计/召回与NousQL.md#候选与排序",tooltip="资源连接器：见设计/召回与NousQL.md"];
intent -> bind [label="提交查询",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；提交查询"];
bind -> plan [label="绑定真实范围",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；绑定真实范围"];
plan -> exact [label="精确与当前内容",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；精确与当前内容"];
plan -> index [label="权限桶与时间前置过滤",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；权限桶与时间前置过滤"];
plan -> topo [label="明确扩张意图",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；明确扩张意图"];
exact -> fusion [label="候选引用",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；候选引用"];
index -> fusion [label="候选及通道名次",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；候选及通道名次"];
topo -> fusion [label="候选及关联路径",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；候选及关联路径"];
fusion -> owners [label="读取有界候选",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；读取有界候选"];
store -> owners [label="实际修订与当前状态",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；实际修订与当前状态"];
owners -> rank [label="完整获准候选",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；完整获准候选"];
rank -> result [label="结果与诊断",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；结果与诊断"];
write -> job [label="同事务安排索引",style="dashed",color="#a26416",fontcolor="#a26416",arrowhead=normal,constraint=true,tooltip="交接：事件或持久工作使后续能力获得机会；同事务安排索引"];
job -> store [label="取得领域搜索表示",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；取得领域搜索表示"];
job -> index [label="幂等更新修订行",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；幂等更新修订行"];
plan -> more [label="明确的外部知识请求",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；明确的外部知识请求"];
more -> result [label="外部材料引用与版本",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；外部材料引用与版本"];
result -> intent [label="下一次结果续接",style="dotted",color="#65717d",fontcolor="#65717d",arrowhead=vee,constraint=true,tooltip="引用：源对象引用目标身份或资料；不表示执行；下一次结果续接"];
}