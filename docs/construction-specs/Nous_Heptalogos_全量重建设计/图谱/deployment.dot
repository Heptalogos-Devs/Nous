ns -> pg [label="Nous业务数据",style="bold",color="#19705c",fontcolor="#19705c",arrowhead=normal,constraint=true,tooltip="提交：在标注事务中写入正式状态；Nous业务数据"];
hs -> pg [label="Hept业务数据",style="bold",color="#19705c",fontcolor="#19705c",arrowhead=normal,constraint=true,tooltip="提交：在标注事务中写入正式状态；Hept业务数据"];
hs -> claw [label="实际模型/工具/发送",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；实际模型/工具/发送"];
claw -> nap [label="平台连接与操作",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；平台连接与操作"];
os -> ns [label="进程启停",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；进程启停"];
os -> hs [label="进程启停",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；进程启停"];
os -> claw [label="原生服务生命周期",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；原生服务生命周期"];
maint -> os [label="明确机器运维授权",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；明确机器运维授权"];
ns -> files [label="所属材料读写",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；所属材料读写"];
claw -> files [label="原生历史与工作文件",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；原生历史与工作文件"];
operator -> quiet [label="明确备份",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；明确备份"];
quiet -> ns [label="暂停新采用与成长",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；暂停新采用与成长"];
quiet -> hs [label="暂停新主动工作",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；暂停新主动工作"];
quiet -> dump [label="同一静默范围快照",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；同一静默范围快照"];
dump -> restic [label="数据库与文件清单",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；数据库与文件清单"];
restic -> restore [label="选定快照",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；选定快照"];
restore -> pg [label="恢复正式状态",style="bold",color="#19705c",fontcolor="#19705c",arrowhead=normal,constraint=true,tooltip="提交：在标注事务中写入正式状态；恢复正式状态"];
restore -> files [label="恢复材料与原生记录",style="bold",color="#19705c",fontcolor="#19705c",arrowhead=normal,constraint=true,tooltip="提交：在标注事务中写入正式状态；恢复材料与原生记录"];
}