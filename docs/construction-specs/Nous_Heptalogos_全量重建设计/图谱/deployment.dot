digraph target {
graph [rankdir=TB, fontname="Noto Sans CJK SC", fontsize=17, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.65", splines=polyline, label="运行、管理与备份 · 目标设计", labelloc=t];
node [fontname="Noto Sans CJK SC",fontsize=11,color="#77818b",margin="0.17,0.10",penwidth=1.0];
edge [fontname="Noto Sans CJK SC",fontsize=9,arrowsize=0.7,penwidth=1.1];
operator [label="操作者 / 远程Console / CLI",shape=hexagon,style="filled",fillcolor="#efedf6",URL="../设计/部署可移植性与清除.md#运行单元",tooltip="操作者 / 远程Console / CLI：见设计/部署可移植性与清除.md"];
mgmt [label="产品 Management API",shape=box,style="rounded,filled",fillcolor="#e9eef4",URL="../设计/部署可移植性与清除.md#运行单元",tooltip="产品 Management API：见设计/部署可移植性与清除.md"];
ns [label="Nous Service",shape=box,style="rounded,filled",fillcolor="#e9eef4",URL="../设计/部署可移植性与清除.md#运行单元",tooltip="Nous Service：见设计/部署可移植性与清除.md"];
hs [label="Heptalogos Service",shape=box,style="rounded,filled",fillcolor="#e9eef4",URL="../设计/部署可移植性与清除.md#运行单元",tooltip="Heptalogos Service：见设计/部署可移植性与清除.md"];
pg [label="PostgreSQL\nnous / heptalogos 两库",shape=cylinder,style="filled",fillcolor="#e8f0f3",URL="../设计/部署可移植性与清除.md#运行单元",tooltip="PostgreSQL\nnous / heptalogos 两库：见设计/部署可移植性与清除.md"];
claw [label="OpenClaw 原生运行",shape=hexagon,style="filled",fillcolor="#efedf6",URL="../设计/部署可移植性与清除.md#运行单元",tooltip="OpenClaw 原生运行：见设计/部署可移植性与清除.md"];
nap [label="NapCat / 其他渠道",shape=hexagon,style="filled",fillcolor="#efedf6",URL="../设计/部署可移植性与清除.md#运行单元",tooltip="NapCat / 其他渠道：见设计/部署可移植性与清除.md"];
os [label="systemd / SCM / launchd",shape=hexagon,style="filled",fillcolor="#efedf6",URL="../设计/部署可移植性与清除.md#运行单元",tooltip="systemd / SCM / launchd：见设计/部署可移植性与清除.md"];
maint [label="独立机器维护助手",shape=hexagon,style="filled",fillcolor="#efedf6",URL="../设计/部署可移植性与清除.md#运行单元",tooltip="独立机器维护助手：见设计/部署可移植性与清除.md"];
files [label="材料 / workspace / 原生状态",shape=cylinder,style="filled",fillcolor="#e8f0f3",URL="../设计/部署可移植性与清除.md#运行单元",tooltip="材料 / workspace / 原生状态：见设计/部署可移植性与清除.md"];
quiet [label="短暂静默备份操作",shape=box,style="filled",fillcolor="#eef7f4",URL="../设计/部署可移植性与清除.md#运行单元",tooltip="短暂静默备份操作：见设计/部署可移植性与清除.md"];
dump [label="PG dump + 原生备份",shape=hexagon,style="filled",fillcolor="#efedf6",URL="../设计/部署可移植性与清除.md#运行单元",tooltip="PG dump + 原生备份：见设计/部署可移植性与清除.md"];
restic [label="restic 加密与远端存储",shape=hexagon,style="filled",fillcolor="#efedf6",URL="../设计/部署可移植性与清除.md#运行单元",tooltip="restic 加密与远端存储：见设计/部署可移植性与清除.md"];
restore [label="恢复数据→核实授权→启用",shape=box,style="filled",fillcolor="#eef7f4",URL="../设计/部署可移植性与清除.md#运行单元",tooltip="恢复数据→核实授权→启用：见设计/部署可移植性与清除.md"];
operator -> mgmt [label="同一管理合同",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；同一管理合同"];
