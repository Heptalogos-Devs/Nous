digraph target {
graph [rankdir=TB, fontname="Noto Sans CJK SC", fontsize=17, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.65", splines=polyline, label="多文件种子、主体迁移与分支 · 目标设计", labelloc=t];
node [fontname="Noto Sans CJK SC",fontsize=11,color="#77818b",margin="0.17,0.10",penwidth=1.0];
edge [fontname="Noto Sans CJK SC",fontsize=9,arrowsize=0.7,penwidth=1.1];
files [label="多份Markdown / 图片",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/种子主体包与分支.md#预览与采用",tooltip="多份Markdown / 图片：见设计/种子主体包与分支.md"];
draft [label="SeedPackage 草稿版本",shape=cylinder,style="filled",fillcolor="#e8f0f3",URL="../设计/种子主体包与分支.md#预览与采用",tooltip="SeedPackage 草稿版本：见设计/种子主体包与分支.md"];
preview [label="seeds.preview",shape=box,style="filled",fillcolor="#eef7f4",URL="../设计/种子主体包与分支.md#预览与采用",tooltip="seeds.preview：见设计/种子主体包与分支.md"];
proposal [label="可编辑跨域提案",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/种子主体包与分支.md#预览与采用",tooltip="可编辑跨域提案：见设计/种子主体包与分支.md"];
selection [label="操作者选择采用范围",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/种子主体包与分支.md#预览与采用",tooltip="操作者选择采用范围：见设计/种子主体包与分支.md"];
adopt [label="seeds.adopt\n相关领域同一事务",shape=box,style="filled",fillcolor="#eef7f4",URL="../设计/种子主体包与分支.md#预览与采用",tooltip="seeds.adopt\n相关领域同一事务：见设计/种子主体包与分支.md"];
n [label="Nous Self / Social / Motivation",shape=cylinder,style="filled",fillcolor="#e8f0f3",URL="../设计/种子主体包与分支.md#预览与采用",tooltip="Nous Self / Social / Motivation：见设计/种子主体包与分支.md"];
world [label="Hept world.enter\n可选独立操作",shape=box,style="filled",fillcolor="#eef7f4",URL="../设计/种子主体包与分支.md#预览与采用",tooltip="Hept world.enter\n可选独立操作：见设计/种子主体包与分支.md"];
export [label="subjects.export",shape=box,style="filled",fillcolor="#eef7f4",URL="../设计/种子主体包与分支.md#预览与采用",tooltip="subjects.export：见设计/种子主体包与分支.md"];
bundle [label="主体包\n公开数据与材料",shape=note,style="filled",fillcolor="#faf5e9",URL="../设计/种子主体包与分支.md#预览与采用",tooltip="主体包\n公开数据与材料：见设计/种子主体包与分支.md"];
mode [label="导入目的",shape=diamond,style="filled",fillcolor="#fff0d9",URL="../设计/种子主体包与分支.md#预览与采用",tooltip="导入目的：见设计/种子主体包与分支.md"];
restore [label="同一身份迁移",shape=ellipse,style="filled",fillcolor="#f2ecf7",URL="../设计/种子主体包与分支.md#预览与采用",tooltip="同一身份迁移：见设计/种子主体包与分支.md"];
fork [label="新Subject与引用映射",shape=ellipse,style="filled",fillcolor="#f2ecf7",URL="../设计/种子主体包与分支.md#预览与采用",tooltip="新Subject与引用映射：见设计/种子主体包与分支.md"];
files -> draft [label="保存来源文档",style="bold",color="#19705c",fontcolor="#19705c",arrowhead=normal,constraint=true,tooltip="提交：在标注事务中写入正式状态；保存来源文档"];
draft -> preview [label="解释选定版本",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；解释选定版本"];
preview -> proposal [label="内容与来源位置",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；内容与来源位置"];
proposal -> selection [label="实际预览",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；实际预览"];
selection -> adopt [label="选定内容与目标修订",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；选定内容与目标修订"];
adopt -> n [label="采用结果与原文关联",style="bold",color="#19705c",fontcolor="#19705c",arrowhead=normal,constraint=true,tooltip="提交：在标注事务中写入正式状态；采用结果与原文关联"];
selection -> world [label="明确选择世界入场",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；明确选择世界入场"];
n -> export [label="选定认知及历史",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；选定认知及历史"];
world -> export [label="有权限的世界部分",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；有权限的世界部分"];
export -> bundle [label="材料与manifest",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；材料与manifest"];
bundle -> mode [label="读取导入包",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；读取导入包"];
mode -> restore [label="继续原SubjectId",style="solid",color="#805497",fontcolor="#805497",arrowhead=normal,constraint=true,tooltip="状态：标注条件成立时发生业务状态转换；继续原SubjectId"];
mode -> fork [label="复制/分享新主体",style="solid",color="#805497",fontcolor="#805497",arrowhead=normal,constraint=true,tooltip="状态：标注条件成立时发生业务状态转换；复制/分享新主体"];
}