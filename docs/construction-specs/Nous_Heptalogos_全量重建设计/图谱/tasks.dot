device -> native [label="实际工具结果",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；实际工具结果"];
native -> result [label="正式成果与运行引用",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；正式成果与运行引用"];
result -> notice [label="成果到达",style="dashed",color="#a26416",fontcolor="#a26416",arrowhead=normal,constraint=true,tooltip="交接：事件或持久工作使后续能力获得机会；成果到达"];
notice -> read [label="可供选择的通知",style="solid",color="#555e68",fontcolor="#555e68",arrowhead=normal,constraint=true,tooltip="数据：源节点把标注内容提供给目标；可供选择的通知"];
read -> result [label="读取实际所需部分",style="solid",color="#254e70",fontcolor="#254e70",arrowhead=normal,constraint=true,tooltip="调用：源节点请求目标完成标注操作；读取实际所需部分"];
