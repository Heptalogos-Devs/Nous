native [label="OpenClaw run / subagent",shape=hexagon,style="filled",fillcolor="#efedf6",URL="../设计/活动任务与计算环境.md#委派与成果交付",tooltip="OpenClaw run / subagent：见设计/活动任务与计算环境.md"];
