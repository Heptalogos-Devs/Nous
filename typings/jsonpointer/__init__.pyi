"""The used public boundary of jsonpointer 3, which ships without typing metadata."""

class JsonPointerException(Exception): ...

class JsonPointer:
    parts: list[str]
    def __init__(self, pointer: str) -> None: ...
    def resolve(self, doc: object) -> object: ...
    def set(self, doc: object, value: object, inplace: bool = True) -> object: ...

def resolve_pointer(doc: object, pointer: str) -> object: ...
