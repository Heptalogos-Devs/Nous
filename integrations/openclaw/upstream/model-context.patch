diff --git a/packages/agent-core/src/model-context.test.ts b/packages/agent-core/src/model-context.test.ts
new file mode 100644
index 00000000..79b3eb49
--- /dev/null
+++ b/packages/agent-core/src/model-context.test.ts
@@ -0,0 +1,108 @@
+import { expect, it } from "vitest";
+import {
+  captureAgentLoop,
+  config,
+  createTurnSequenceStream,
+  makeCall,
+  makeTool,
+  model,
+  user,
+} from "./agent-loop.test-support.js";
+
+it("prepares each actual model step after projection and accepts its saved output before continuing", async () => {
+  const order: string[] = [];
+  const inputs: { prompt?: string; model: string; count: number }[] = [];
+  let sequence = 0;
+  let persisted = () => false;
+  const task = captureAgentLoop(
+    [user("Read the note and answer")],
+    {
+      systemPrompt: "Native role",
+      messages: [],
+      tools: [makeTool("read")],
+    },
+    {
+      ...config,
+      transformContext: async (messages) => {
+        order.push("project");
+        return messages;
+      },
+      prepareNextTurn: () => ({ model: { ...model, id: "second-model" } }),
+      modelContext: {
+        async prepare({ model: actual }) {
+          sequence++;
+          order.push(`prepare:${sequence}`);
+          return {
+            callId: `call-${sequence}`,
+            view: { revision: sequence },
+            systemPromptAddition: `Cognition ${sequence}`,
+          };
+        },
+        async dispatch({ prepared }) {
+          order.push(`dispatch:${prepared.callId}`);
+        },
+        async accept({ prepared }) {
+          const call = prepared.callId;
+          expect(persisted()).toBe(true);
+          order.push(`accept:${call}`);
+        },
+      },
+    },
+    undefined,
+    (actual, context) => {
+      order.push(`provider:${inputs.length + 1}`);
+      inputs.push({
+        prompt: context.systemPrompt,
+        model: actual.id,
+        count: context.messages.length,
+      });
+      return createTurnSequenceStream([
+        inputs.length === 1 ? [makeCall("read")] : [{ type: "text", text: "Read the note" }],
+      ])(actual, context);
+    },
+  );
+  persisted = () =>
+    task.events.some((event) => event.type === "message_end" && event.message.role === "assistant");
+  await task.result;
+  expect(inputs.map((input) => input.prompt)).toEqual([
+    "Native role\n\nCognition 1",
+    "Native role\n\nCognition 2",
+  ]);
+  expect(inputs.map((input) => input.model)).toEqual([model.id, "second-model"]);
+  expect(order).toEqual([
+    "project",
+    "prepare:1",
+    "dispatch:call-1",
+    "provider:1",
+    "accept:call-1",
+    "project",
+    "prepare:2",
+    "dispatch:call-2",
+    "provider:2",
+    "accept:call-2",
+  ]);
+
+  let dispatched = false;
+  const failure = captureAgentLoop(
+    [user()],
+    { systemPrompt: "", messages: [], tools: [] },
+    {
+      ...config,
+      modelContext: {
+        async prepare() {
+          throw new Error("Context dependency unavailable");
+        },
+        async accept() {
+          throw new Error("No response should exist");
+        },
+      },
+    },
+    undefined,
+    () => {
+      dispatched = true;
+      throw new Error("No provider call allowed");
+    },
+  );
+  await expect(failure.result).rejects.toThrow("Context dependency unavailable");
+  expect(dispatched).toBe(false);
+});
