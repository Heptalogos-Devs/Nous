index 00000000..8ef6ce0b
--- /dev/null
+++ b/packages/agent-core/src/model-context.test.ts
@@ -0,0 +1,154 @@
+import { expect, it } from "vitest";
+import {
+  captureAgentLoop,
+  config,
+  createTurnSequenceStream,
+  makeCall,
+  makeTool,
+  makeAssistantMessage,
+  model,
+  user,
+} from "./agent-loop.test-support.js";
+
+it("prepares each actual model step after projection and accepts its saved output before continuing", async () => {
+  const order: string[] = [];
+  const inputs: { prompt?: string; model: string; count: number }[] = [];
+  let sequence = 0;
+  let persisted = () => false;
+  const task = captureAgentLoop(
+    [user("Read the note and answer")],
+    {
+      systemPrompt: "Native role",
+      messages: [],
+      tools: [makeTool("read")],
+    },
+    {
+      ...config,
+      transformContext: async (messages) => {
+        order.push("project");
+        return messages;
+      },
+      prepareNextTurn: () => ({ model: { ...model, id: "second-model" } }),
+      modelContext: {
+        async prepare({ model: actual, context }) {
+          sequence++;
+          if (sequence > 1)
+            expect(
+              context.messages.findLast((message) => message.role === "assistant"),
+            ).toMatchObject({ modelContext: { outputRef: "original-output" } });
+          order.push(`prepare:${sequence}`);
+          return {
+            callId: `call-${sequence}`,
+            view: { revision: sequence },
+            systemPromptAddition: `Cognition ${sequence}`,
+          };
+        },
+        async dispatch({ prepared }) {
+          order.push(`dispatch:${prepared.callId}`);
+        },
+        async accept({ prepared }) {
+          const call = prepared.callId;
+          expect(persisted()).toBe(true);
+          order.push(`accept:${call}`);
+          return { outputRef: "original-output" };
+        },
+      },
+    },
+    undefined,
+    (actual, context) => {
+      order.push(`provider:${inputs.length + 1}`);
+      inputs.push({
+        prompt: context.systemPrompt,
+        model: actual.id,
+        count: context.messages.length,
+      });
+      return createTurnSequenceStream([
+        inputs.length === 1 ? [makeCall("read")] : [{ type: "text", text: "Read the note" }],
+      ])(actual, context);
+    },
+  );
+  persisted = () =>
+    task.events.some((event) => event.type === "message_end" && event.message.role === "assistant");
+  await task.result;
+  expect(inputs.map((input) => input.prompt)).toEqual([
+    "Native role\n\nCognition 1",
+    "Native role\n\nCognition 2",
+  ]);
+  expect(inputs.map((input) => input.model)).toEqual([model.id, "second-model"]);
+  expect(order).toEqual([
+    "project",
+    "prepare:1",
+    "dispatch:call-1",
+    "provider:1",
+    "accept:call-1",
+    "project",
+    "prepare:2",
+    "dispatch:call-2",
+    "provider:2",
+    "accept:call-2",
+  ]);
+
+  let dispatched = false;
+  const failure = captureAgentLoop(
+    [user()],
+    { systemPrompt: "", messages: [], tools: [] },
+    {
+      ...config,
+      modelContext: {
+        async prepare() {
+          throw new Error("Context dependency unavailable");
+        },
+        async accept() {
+          throw new Error("No response should exist");
+        },
+      },
+    },
+    undefined,
+    () => {
+      dispatched = true;
+      throw new Error("No provider call allowed");
+    },
+  );
+  await expect(failure.result).rejects.toThrow("Context dependency unavailable");
+  expect(dispatched).toBe(false);
+});
+
+it("resumes an accepted unstarted tool response through the native executor without repeating its provider", async () => {
+  const { Agent } = await import("./agent.js");
+  const tools: string[] = [];
+  const callId = "original-run:original-call";
+  const terminal = {
+    ...makeAssistantMessage([makeCall("read")]),
+    modelContext: { callId, terminal: true, outputRef: { id: "saved-output" } },
+  };
+  let physical = 0,
+    recovered = 0;
+  const agent = new Agent({
+    initialState: { model, tools: [makeTool("read", tools)], messages: [user(), terminal] },
+    streamFn: (actual, context, options) => {
+      physical++;
+      expect(context.messages.some((message) => message.role === "toolResult")).toBe(true);
+      return createTurnSequenceStream([[{ type: "text", text: "Original tool result received" }]])(
+        actual,
+        context,
+        options,
+      );
+    },
+  });
+  agent.modelContext = {
+    async recover(input) {
+      expect(input.callId).toBe(callId);
+      recovered++;
+    },
+    async prepare() {
+      return undefined;
+    },
+    async accept() {},
+  };
+  await agent.resumeToolCalls({ callId });
+  expect(agent.state.errorMessage).toBeUndefined();
+  expect(recovered).toBe(1);
+  expect(tools).toEqual(["read"]);
+  expect(physical).toBe(1);
+  expect(agent.state.messages.filter((message) => message === terminal)).toHaveLength(1);
+});
