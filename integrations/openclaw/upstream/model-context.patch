+import { expect, it, vi } from "vitest";
+const state = vi.hoisted(() => ({
+  config: {
+    agents: {
+      defaults: {
+        model: { primary: "fixture/selected" },
+        modelPolicy: { allow: ["fixture/selected"] },
+      },
+    },
+  },
+  current: true,
+  model: {
+    provider: "fixture",
+    id: "selected",
+    name: "Selected",
+    api: "openai-completions",
+    baseUrl: "https://provider.invalid/v1",
+    input: ["text", "image"],
+    reasoning: true,
+    contextWindow: 64000,
+    maxTokens: 4096,
+    headers: { authorization: "fixture-private-key" },
+    compat: { supportsTools: false },
+  },
+  createStores: vi.fn(() => {
+    throw new Error("Credential stores must not be resolved by a metadata read");
+  }),
+}));
+vi.mock("../config/config.js", () => ({ getRuntimeConfig: () => state.config }));
+vi.mock("./prepared-model-catalog.js", () => ({
+  getPublishedPreparedModelCatalogOwnerSnapshot: () => ({
+    isCurrent: () => state.current,
+    metadataSnapshot: { plugins: [], owners: { modelIdNormalizationPolicies: new Map() } },
+    modelCatalog: {
+      entries: [{ provider: "fixture", id: "selected", name: "Selected" }],
+      routeVariants: [],
+    },
+    findConfiguredRuntimeModel: (provider: string, id: string) =>
+      provider === state.model.provider && id === state.model.id ? state.model : undefined,
+    createStores: state.createStores,
+  }),
+}));
+import { readPublishedModelBinding } from "./published-model-binding.js";
+it("projects the published default and exact route, current policy and revision without acquiring credentials", () => {
+  const first = readPublishedModelBinding({ agentId: "main" });
+  expect(first).toMatchObject({
+    provider: "fixture",
+    modelId: "selected",
+    contextWindow: 64000,
+    maxTokens: 4096,
+    supportsTools: false,
+    reasoning: true,
+    input: ["text", "image"],
+  });
+  expect(JSON.stringify(first)).not.toMatch(/private-key|authorization|provider.invalid|baseUrl/);
+  state.model.baseUrl = "https://replacement.invalid/v1";
+  expect(
+    readPublishedModelBinding({ agentId: "main", provider: "fixture", modelId: "selected" })
+      .configRevision,
+  ).not.toBe(first.configRevision);
+  expect(() =>
+    readPublishedModelBinding({ agentId: "main", provider: "fixture", modelId: "blocked" }),
+  ).toThrow("outside this agent's current model policy");
+  state.current = false;
+  expect(() => readPublishedModelBinding({ agentId: "main" })).toThrow("not currently published");
+  expect(state.createStores).not.toHaveBeenCalled();
+});
