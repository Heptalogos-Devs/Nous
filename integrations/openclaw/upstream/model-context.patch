+
+/** Project an already decoded archived event inside the native archive owner. */
+export function projectSessionModelCallEvent(
+  event: unknown,
+  callId: string,
+): Record<string, unknown> | undefined {
+  if (!event || typeof event !== "object") return;
+  const e = event as Record<string, any>,
+    data = e.data ?? {},
+    message = e.message ?? {};
+  if (data.callId !== callId && message.modelContext?.callId !== callId) return;
+  const output =
+    e.customType === "openclaw.model-context.auxiliary-output" ? (data.output ?? {}) : message;
+  return {
+    id: e.id,
+    type: e.type,
+    customType: e.customType,
+    runId: data.runId,
+    role: data.role,
+    provider: data.invocation?.provider,
+    modelId: data.invocation?.model,
+    inputTokensEstimate: data.invocation?.inputTokensEstimate,
+    outputTokens: data.invocation?.outputTokens,
+    inputRefs: data.prepared?.inputRefs,
+    outcome: data.outcome,
+    terminal: message.modelContext?.terminal === true ? 1 : 0,
+    stopReason: output.stopReason,
+    providerRequestId: output.responseId,
+    providerRefused: output.diagnostics?.some((row: any) => row.type === "provider_refusal")
+      ? 1
+      : 0,
+    usage: output.usage,
+    outputRef: message.modelContext?.outputRef ?? data.outputRef,
+    selectedOutputRefs: message.modelContext?.selectedOutputRefs ?? data.selectedOutputRefs,
+  };
+}
