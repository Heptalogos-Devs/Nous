+import {
+  identifiedClient,
+  initializeSessionReadContext,
+  requestContext,
+} from "./sessions-read-cache.test-support.js";
+
+it("reads actual prepared, dispatch and terminal facts through the native owner without transcript bodies", async () => {
+  await withOpenClawTestState({ scenario: "minimal" }, async (state) => {
+    const scope = {
+      agentId: "main",
+      sessionKey: "agent:main:model-call",
+      sessionId: "native-session-uuid",
+      storePath: path.join(state.agentDir("main"), "openclaw-agent.sqlite"),
+    };
+    const runId = "native-run",
+      callId = `${runId}:019a0000-0000-7000-8000-000000000001`;
+    replaceSessionEntrySync(scope, {
+      sessionId: scope.sessionId,
+      updatedAt: 1,
+      visibility: "shared",
+    });
+    const events = [
+      {
+        type: "session",
+        version: CURRENT_SESSION_VERSION,
+        id: scope.sessionId,
+        timestamp: new Date(0).toISOString(),
+        cwd: state.stateDir,
+      },
+      {
+        type: "custom",
+        id: "prepared",
+        parentId: null,
+        customType: "openclaw.model-context.prepared",
+        data: {
+          runId,
+          callId,
+          role: "worker",
+          prepared: { view: { blocks: ["secret prompt body"] } },
+          invocation: {
+            provider: "native-provider",
+            model: "actual-model",
+            inputTokensEstimate: 42,
+            outputTokens: 128,
+          },
+        },
+      },
+    ];
+    await replaceTranscriptEvents(scope, events);
+    const context = requestContext({ agents: { entries: { main: {} } } });
+    await initializeSessionReadContext(context);
+    const read = async (sessionId = scope.sessionId) => {
+      const respond = vi.fn();
+      await sessionByKeyReadHandlers["sessions.modelCall"]!({
+        req: { type: "req", id: "call-facts", method: "sessions.modelCall" },
+        params: { key: scope.sessionKey, sessionId, runId, callId },
+        client: identifiedClient("synthetic-viewer"),
+        context,
+        respond,
+        isWebchatConnect: () => false,
+      });
+      expect(respond).toHaveBeenCalledOnce();
+      expect(respond.mock.calls[0]?.[0]).toBe(true);
+      return respond.mock.calls[0]?.[1];
+    };
+    expect(await read()).toMatchObject({
+      call: {
+        agentId: scope.agentId,
+        sessionKey: scope.sessionKey,
+        sessionId: scope.sessionId,
+        runId,
+        callId,
+        active: true,
+        dispatched: false,
+        notDispatched: false,
+        prepared: {
+          entryId: "prepared",
+          provider: "native-provider",
+          modelId: "actual-model",
+          inputTokensEstimate: 42,
+        },
+      },
+    });
+    expect(await read("another-session")).toEqual({ call: null });
+    await replaceTranscriptEvents(scope, [
+      ...events,
+      {
+        type: "custom",
+        id: "dispatch",
+        parentId: "prepared",
+        customType: "openclaw.model-context.dispatched",
+        data: { callId },
+      },
+      {
+        type: "message",
+        id: "terminal",
+        parentId: "dispatch",
+        message: {
+          role: "assistant",
+          api: "openai-completions",
+          provider: "native-provider",
+          model: "actual-model",
+          timestamp: 2,
+          content: [{ type: "text", text: "secret output body" }],
+          errorMessage: "secret provider body",
+          stopReason: "stop",
+          responseId: "provider-request",
+          modelContext: { callId, terminal: true },
+          usage: { input: 30, output: 12, cacheRead: 3, cacheWrite: 2, cost: { total: 999 } },
+        },
+      },
+      {
+        type: "custom",
+        id: "settled",
+        parentId: "terminal",
+        customType: "openclaw.model-context.settled",
+        data: { callId, outcome: "completed" },
+      },
+    ]);
+    const actual = await read();
+    expect(actual).toMatchObject({
+      call: {
+        dispatched: true,
+        terminal: {
+          entryId: "terminal",
+          providerRequestId: "provider-request",
+          usage: { input: 30, output: 12 },
+        },
+        settlement: { entryId: "settled", outcome: "completed" },
+      },
+    });
+    expect(JSON.stringify(actual)).not.toMatch(/secret|cost|999/);
+    const manager = await SessionManager.openAsync(scope);
+    const terminal = manager
+      .getBranch()
+      .find((entry) => entry.type === "message" && entry.id === "terminal");
+    if (terminal?.type !== "message" || terminal.message.role !== "assistant")
+      throw new Error("Missing native terminal");
+    const outputRef = {
+      product: "nous",
+      installationId: "actual-nous",
+      subjectId: "subject",
+      kind: "Material",
+      id: "accepted",
+      revision: 1,
+    };
+    await withSessionManagerWrite(manager, () =>
+      rewriteTranscriptEntriesInSessionManager({
+        sessionManager: manager,
+        replacements: [
+          {
+            entryId: terminal.id,
+            message: {
+              ...terminal.message,
+              modelContext: {
+                ...terminal.message.modelContext!,
+                outputRef,
+                selectedOutputRefs: [outputRef],
+              },
+            },
+          },
+        ],
+        preserveReplacementCompactionReplay: true,
+      }),
+    );
+    expect(await read()).toMatchObject({
+      call: { terminal: { outputRef, selectedOutputRefs: [outputRef] } },
+    });
