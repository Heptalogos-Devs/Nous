diff --git a/src/agents/embedded-agent-runner/model-context-recovery.ts b/src/agents/embedded-agent-runner/model-context-recovery.ts
new file mode 100644
index 00000000..10ec6f3f
--- /dev/null
+++ b/src/agents/embedded-agent-runner/model-context-recovery.ts
@@ -0,0 +1,159 @@
+import { MODEL_CONTEXT_ACCEPT_FAILURE_CODE } from "../../../packages/agent-core/src/errors.js";
+import type { Agent } from "../runtime/index.js";
+import { withSessionManagerWrite } from "../sessions/session-manager-write-admission.js";
+import type { SessionManager } from "../sessions/session-manager.js";
+
+export class ModelContextToolRecoveryError extends Error {
+  constructor(
+    readonly code:
+      | "native.recovery_scope_changed"
+      | "native.recovery_plan_changed"
+      | "native.recovery_effect_unknown"
+      | "native.recovery_proof_unavailable",
+    message: string,
+  ) {
+    super(message);
+    this.name = "ModelContextToolRecoveryError";
+  }
+}
+
+export type ModelContextToolRecoveryPlan = {
+  sessionKey: string;
+  sessionId: string;
+  runId: string;
+  callId: string;
+  terminalEntryId: string;
+  pendingToolCallIds: string[];
+};
+
+/** The accept failure precedes all synchronous tool starts in the native stream owner. */
+export function readModelContextToolRecoveryPlan(
+  manager: SessionManager,
+  request: Pick<ModelContextToolRecoveryPlan, "sessionKey" | "sessionId" | "runId" | "callId">,
+): ModelContextToolRecoveryPlan {
+  const target = manager.getSessionTarget();
+  if (target?.sessionKey !== request.sessionKey || manager.getSessionId() !== request.sessionId)
+    throw new ModelContextToolRecoveryError(
+      "native.recovery_scope_changed",
+      "Native recovery session binding changed",
+    );
+  const branch = manager.getBranch();
+  const prepared = branch.findLast(
+    (entry) => entry.type === "custom" && entry.customType === "openclaw.model-context.prepared",
+  );
+  if (
+    prepared?.type !== "custom" ||
+    (prepared.data as { callId?: string; runId?: string }).callId !== request.callId ||
+    (prepared.data as { runId?: string }).runId !== request.runId ||
+    !request.callId.startsWith(`${request.runId}:`)
+  )
+    throw new ModelContextToolRecoveryError(
+      "native.recovery_plan_changed",
+      "Native recovery requires the latest prepared call of this run",
+    );
+  const terminalIndex = branch.findLastIndex(
+    (entry) =>
+      entry.type === "message" &&
+      entry.message.role === "assistant" &&
+      entry.message.modelContext?.callId === request.callId &&
+      entry.message.modelContext.terminal,
+  );
+  const preparedIndex = branch.indexOf(prepared);
+  const callEvents = branch.slice(preparedIndex + 1, terminalIndex + 1);
+  if (
+    !callEvents.some(
+      (entry) =>
+        entry.type === "custom" &&
+        entry.customType === "openclaw.model-context.dispatched" &&
+        (entry.data as { callId?: string }).callId === request.callId,
+    ) ||
+    callEvents.some(
+      (entry) =>
+        entry.type === "custom" &&
+        entry.customType === "openclaw.model-context.not-dispatched" &&
+        (entry.data as { callId?: string }).callId === request.callId,
+    ) ||
+    callEvents.some(
+      (entry) =>
+        entry.type === "message" &&
+        (entry.message.role === "toolResult" ||
+          (entry.message.role === "assistant" &&
+            !entry.message.modelContext?.terminal &&
+            entry.message.content.some((part) => part.type === "toolCall"))),
+    )
+  )
+    throw new ModelContextToolRecoveryError(
+      "native.recovery_effect_unknown",
+      "Native recovery cannot prove that the saved call has no earlier tool effects",
+    );
+  const terminal = branch[terminalIndex];
+  if (
+    terminal?.type !== "message" ||
+    terminal.message.role !== "assistant" ||
+    terminal.message.stopReason !== "toolUse"
+  )
+    throw new ModelContextToolRecoveryError(
+      "native.recovery_proof_unavailable",
+      "Native recovery has no successful saved tool response",
+    );
+  const calls = terminal.message.content.filter((part) => part.type === "toolCall");
+  if (!calls.length || calls.some((call) => call.async === true))
+    throw new ModelContextToolRecoveryError(
+      "native.recovery_effect_unknown",
+      "Native recovery requires unstarted synchronous tools",
+    );
+  const suffix = branch.slice(terminalIndex + 1);
+  const failures = suffix.filter((entry) => entry.type === "message");
+  if (
+    !failures.length ||
+    suffix.some((entry) => entry.type === "message" && entry.message.role === "toolResult") ||
+    suffix.some(
+      (entry) => entry.type === "custom" && entry.customType === "openclaw.model-context.settled",
+    )
+  )
+    throw new ModelContextToolRecoveryError(
+      "native.recovery_effect_unknown",
+      "Native recovery requires inspection after tool admission or branch publication",
+    );
+  if (
+    failures.length !== 1 ||
+    failures[0]?.type !== "message" ||
+    failures[0].message.role !== "assistant" ||
+    failures[0].message.stopReason !== "error" ||
+    failures[0].message.modelContext ||
+    failures[0].message.errorCode !== MODEL_CONTEXT_ACCEPT_FAILURE_CODE ||
+    failures[0].message.modelContextFailure?.phase !== "accept" ||
+    failures[0].message.modelContextFailure.callId !== request.callId
+  )
+    throw new ModelContextToolRecoveryError(
+      "native.recovery_proof_unavailable",
+      "Native recovery cannot prove that these tool calls were never launched",
+    );
+  return {
+    sessionKey: request.sessionKey,
+    sessionId: request.sessionId,
+    runId: request.runId,
+    callId: request.callId,
+    terminalEntryId: terminal.id,
+    pendingToolCallIds: calls.map((call) => call.id),
+  };
+}
+
+/** Rebranch the native history and reuse the original executor, policy hooks and next-turn loop. */
+export async function recoverModelContextTools(input: {
+  agent: Agent;
+  sessionManager: SessionManager;
+  expected: ModelContextToolRecoveryPlan;
+}): Promise<void> {
+  const current = readModelContextToolRecoveryPlan(input.sessionManager, input.expected);
+  if (JSON.stringify(current) !== JSON.stringify(input.expected))
+    throw new ModelContextToolRecoveryError(
+      "native.recovery_plan_changed",
+      "Native tool recovery plan changed",
+    );
+  await withSessionManagerWrite(input.sessionManager, () =>
+    input.sessionManager.branchAsync(current.terminalEntryId),
+  );
+  input.agent.state.messages = input.sessionManager.buildSessionContext().messages;
+  await input.agent.resumeToolCalls({ callId: current.callId });
+}
