+++ b/src/agents/embedded-agent-runner/run/attempt.model-context.ts
@@ -0,0 +1,413 @@
+import type { AssistantMessage } from "@openclaw/llm-core";
+import { isProviderRefusalAssistantError } from "@openclaw/llm-core/diagnostics";
+import { getActiveDiagnosticTraceContext } from "../../../infra/diagnostic-trace-context.js";
+import { formatPropagatedDiagnosticTraceparent } from "../../../infra/diagnostic-trace-propagation.js";
+import { getGlobalHookRunner } from "../../../plugins/hook-runner-global.js";
+import type {
+  PluginHookAgentContext,
+  PluginHookModelContextPrepareResult,
+} from "../../../plugins/hook-types.js";
+import { AgentHarnessPreflightError } from "../../harness/errors.js";
+import { estimateTokens } from "../../runtime/index.js";
+import type { guardSessionManager } from "../../session-tool-result-guard-wrapper.js";
+import type { AgentSession } from "../../sessions/index.js";
+import { createManagedSessionId } from "../../sessions/session-manager-id.js";
+import { withSessionManagerWrite } from "../../sessions/session-manager-write-admission.js";
+import { rewriteTranscriptEntriesInSessionManager } from "../transcript-rewrite.js";
+import type { EmbeddedRunAttemptParams } from "./types.js";
+
+const PREPARED = "openclaw.model-context.prepared";
+const DISPATCHED = "openclaw.model-context.dispatched";
+const AUXILIARY_OUTPUT = "openclaw.model-context.auxiliary-output";
+const NOT_DISPATCHED = "openclaw.model-context.not-dispatched";
+const SETTLED = "openclaw.model-context.settled";
+
+type Prepared = {
+  callId: string;
+  runId: string;
+  role?: string;
+  prepared: PluginHookModelContextPrepareResult;
+  invocation: {
+    traceparent?: string;
+    provider: string;
+    model: string;
+    inputTokensEstimate: number;
+    outputTokens: number;
+  };
+};
+
+/** Install the required handoff on the provider boundary, outside compaction. */
+export function installModelContextHandoff(input: {
+  agent: AgentSession["agent"];
+  attempt: Pick<
+    EmbeddedRunAttemptParams,
+    "runId" | "sessionId" | "sessionKey" | "spawnedBy" | "workspaceDir" | "contextTokenBudget"
+  >;
+  sessionManager: ReturnType<typeof guardSessionManager>;
+  agentId: string;
+}): () => void {
+  const runner = getGlobalHookRunner();
+  if (!runner?.hasHooks("model_context_prepare")) {
+    return () => {};
+  }
+  const { agent, attempt, sessionManager } = input;
+  const previous = agent.modelContext;
+  const trace = getActiveDiagnosticTraceContext();
+  const traceparent = formatPropagatedDiagnosticTraceparent(trace);
+  const context: PluginHookAgentContext = {
+    trace,
+    agentId: input.agentId,
+    runId: attempt.runId,
+    sessionId: attempt.sessionId,
+    sessionKey: attempt.sessionKey,
+    parentSessionKey: attempt.spawnedBy ?? undefined,
+    workspaceDir: attempt.workspaceDir,
+    contextTokenBudget: attempt.contextTokenBudget,
+  };
+
+  const required = async <T>(phase: string, operation: () => Promise<T>): Promise<T> => {
+    try {
+      return await operation();
+    } catch (cause) {
+      throw new AgentHarnessPreflightError(`Required model context ${phase} failed`, {
+        cause,
+        userMessage:
+          "Model context handoff is waiting. Continue the existing task after its dependency recovers.",
+      });
+    }
+  };
+  let currentPrepared: Prepared | undefined;
+  const savedResponse = (record: Prepared, entries = sessionManager.getBranch()) => {
+    const start = entries.findIndex(
+      (entry) =>
+        entry.type === "custom" &&
+        entry.customType === PREPARED &&
+        (entry.data as Prepared).callId === record.callId,
+    );
+    const auxiliary = entries.find(
+      (entry) =>
+        entry.type === "custom" &&
+        entry.customType === AUXILIARY_OUTPUT &&
+        (entry.data as { callId: string }).callId === record.callId,
+    );
+    if (auxiliary?.type === "custom")
+      return {
+        output: (auxiliary.data as { output: AssistantMessage }).output,
+        entryId: auxiliary.id,
+      };
+    const fragments: { id: string; message: AssistantMessage }[] = [];
+    for (const candidate of entries.slice(start + 1)) {
+      if (candidate.type === "custom" && candidate.customType === PREPARED) break;
+      if (
+        candidate.type === "message" &&
+        candidate.message.role === "assistant" &&
+        candidate.message.modelContext?.callId === record.callId
+      )
+        fragments.push({ id: candidate.id, message: candidate.message });
+    }
+    const terminal = fragments.at(-1);
+    return terminal?.message.modelContext?.terminal
+      ? {
+          output: {
+            ...terminal.message,
+            content: fragments.flatMap((fragment) => fragment.message.content),
+          },
+          entryId: terminal.id,
+        }
+      : undefined;
+  };
+  const settleNotSent = async (record: Prepared) => {
+    await required("accept", () =>
+      runner.runModelContextAccept(
+        {
+          ...record,
+          traceparent: record.invocation.traceparent,
+          sessionId: attempt.sessionId,
+          outcome: "not_sent",
+        },
+        { ...context, runId: record.runId },
+      ),
+    );
+    await sessionManager.appendCustomEntryAsync(SETTLED, {
+      callId: record.callId,
+      outcome: "not_sent",
+    });
+  };
+  const settle = async (record: Prepared, output: AssistantMessage, entryId?: string) => {
+    const persistAccepted = async (accepted: {
+      outputRef?: unknown;
+      selectedOutputRefs?: unknown[];
+    }) => {
+      if (!accepted.outputRef) return;
+      const entries = sessionManager.getBranch();
+      const entry =
+        entries.findLast(
+          (candidate) =>
+            candidate.type === "message" &&
+            candidate.message.role === "assistant" &&
+            candidate.message.modelContext?.callId === record.callId &&
+            candidate.message.modelContext.terminal,
+        ) ??
+        entries.find(
+          (candidate) =>
+            candidate.type === "custom" &&
+            candidate.customType === AUXILIARY_OUTPUT &&
+            (candidate.data as { callId?: string }).callId === record.callId,
+        );
+      if (!entry)
+        throw new AgentHarnessPreflightError(
+          "Native accepted output has no persisted terminal entry",
+        );
+      if (
+        entry.type === "message" &&
+        entry.message.role === "assistant" &&
+        entry.message.modelContext
+      ) {
+        const metadata = {
+          ...entry.message.modelContext,
+          outputRef: accepted.outputRef,
+          selectedOutputRefs: accepted.selectedOutputRefs,
+        };
+        await withSessionManagerWrite(sessionManager, () =>
+          rewriteTranscriptEntriesInSessionManager({
+            sessionManager,
+            replacements: [
+              { entryId: entry.id, message: { ...entry.message, modelContext: metadata } },
+            ],
+            preserveReplacementCompactionReplay: true,
+          }),
+        );
+        for (const message of agent.state.messages)
+          if (
+            message.role === "assistant" &&
+            message.modelContext?.callId === record.callId &&
+            message.modelContext.terminal
+          )
+            message.modelContext = metadata;
+      } else if (entry.type === "custom") {
+        await withSessionManagerWrite(sessionManager, () =>
+          rewriteTranscriptEntriesInSessionManager({
+            sessionManager,
+            replacements: [],
+            customDataReplacements: [
+              {
+                entryId: entry.id,
+                data: {
+                  ...(entry.data as object),
+                  outputRef: accepted.outputRef,
+                  selectedOutputRefs: accepted.selectedOutputRefs,
+                },
+              },
+            ],
+            preserveReplacementCompactionReplay: true,
+          }),
+        );
+      }
+    };
+    const accepted = await required("accept", () =>
+      runner.runModelContextAccept(
+        {
+          ...record,
+          traceparent: record.invocation.traceparent,
+          sessionId: attempt.sessionId,
+          output,
+          ...(entryId ? { transcriptEntryId: entryId } : {}),
+        },
+        { ...context, runId: record.runId },
+        persistAccepted,
+      ),
+    );
+    const unknown =
+      (output.stopReason === "error" || output.stopReason === "aborted") &&
+      !isProviderRefusalAssistantError(output);
+    await sessionManager.appendCustomEntryAsync(SETTLED, {
+      callId: record.callId,
+      ...(accepted?.outputRef
+        ? { outputRef: accepted.outputRef, selectedOutputRefs: accepted.selectedOutputRefs }
+        : {}),
+      outcome: unknown
+        ? "unknown"
+        : isProviderRefusalAssistantError(output)
+          ? "not_sent"
+          : "completed",
+    });
+    if (unknown) {
+      throw new AgentHarnessPreflightError(
+        `Model call ${record.callId} has an unknown provider outcome`,
+        {
+          userMessage:
+            "The provider outcome is unknown. Inspect this call before starting another model request.",
+        },
+      );
+    }
+  };
+
+  // Source and output remain in the native session. A response saved immediately
+  // before a crash is recovered from that session, then handed off once again.
+  const acceptPending = async () => {
+    const entries = sessionManager.getBranch();
+    const dispatched = new Set(
+      entries.flatMap((entry) =>
+        entry.type === "custom" && entry.customType === DISPATCHED
+          ? [(entry.data as { callId: string }).callId]
+          : [],
+      ),
+    );
+    const unresolved = entries.find(
+      (entry) =>
+        entry.type === "custom" &&
+        entry.customType === SETTLED &&
+        (entry.data as { outcome: string }).outcome === "unknown",
+    );
+    if (unresolved)
+      throw new AgentHarnessPreflightError(
+        "A previous native model call still has an unknown provider outcome",
+      );
+    const notDispatched = new Set(
+      entries.flatMap((entry) =>
+        entry.type === "custom" && entry.customType === NOT_DISPATCHED
+          ? [(entry.data as { callId: string }).callId]
+          : [],
+      ),
+    );
+    const settled = new Set(
+      entries.flatMap((entry) =>
+        entry.type === "custom" && entry.customType === SETTLED
+          ? [(entry.data as { callId: string }).callId]
+          : [],
+      ),
+    );
+    for (let index = 0; index < entries.length; index++) {
+      const entry = entries[index]!;
+      if (entry.type !== "custom" || entry.customType !== PREPARED) {
+        continue;
+      }
+      const record = entry.data as Prepared;
+      if (settled.has(record.callId)) {
+        continue;
+      }
+      if (notDispatched.has(record.callId)) {
+        await settleNotSent(record);
+        continue;
+      }
+      const saved = savedResponse(record, entries);
+      if (!saved) {
+        if (!dispatched.has(record.callId)) {
+          await sessionManager.appendCustomEntryAsync(SETTLED, {
+            callId: record.callId,
+            outcome: "not_sent",
+          });
+          continue;
+        }
+        throw new AgentHarnessPreflightError(
+          `model context call ${record.callId} has an unknown provider outcome; resolve it before continuing`,
+        );
+      }
+      await settle(record, saved.output, saved.entryId);
+    }
+  };
+
+  agent.modelContext = {
+    async prepare({ model, role, context: current, outputTokens, signal }) {
+      await required("recovery", acceptPending);
+      signal?.throwIfAborted();
+      const callId = `${attempt.runId}:${createManagedSessionId()}`;
+      const baseEstimate =
+        current.messages.reduce((sum, message) => sum + estimateTokens(message), 0) +
+        estimateTokens({
+          role: "user",
+          content: `${current.systemPrompt ?? ""}\n${JSON.stringify(current.tools ?? [])}`,
+          timestamp: 0,
+        });
+      const contextLimit = attempt.contextTokenBudget ?? model.contextWindow;
+      if (typeof contextLimit !== "number" || !Number.isFinite(contextLimit) || contextLimit <= 0)
+        throw new AgentHarnessPreflightError(
+          `Native model ${model.provider}/${model.id} has no context limit`,
+        );
+      const prepared = await required("prepare", () =>
+        runner.runModelContextPrepare(
+          {
+            callId,
+            role,
+            traceparent,
+            runId: attempt.runId,
+            sessionId: attempt.sessionId,
+            provider: model.provider,
+            model: model.id,
+            contextLimit,
+            outputTokens,
+            inputTokensEstimate: baseEstimate,
+            transcriptCursor: sessionManager.getLeafEntry()?.id,
+            systemPrompt: current.systemPrompt,
+            messages: current.messages,
+            tools: current.tools ?? [],
+          },
+          context,
+        ),
+      );
+      if (!prepared) {
+        return undefined;
+      }
+      const invocation = {
+        traceparent,
+        provider: model.provider,
+        model: model.id,
+        outputTokens,
+        inputTokensEstimate:
+          baseEstimate +
+          estimateTokens({
+            role: "user",
+            content: prepared.systemPromptAddition ?? "",
+            timestamp: 0,
+          }) +
+          (prepared.messages ?? []).reduce((sum, message) => sum + estimateTokens(message), 0),
+      };
+      await sessionManager.appendCustomEntryAsync(PREPARED, {
+        callId,
+        runId: attempt.runId,
+        role,
+        prepared,
+        invocation,
+      } satisfies Prepared);
+      currentPrepared = { callId, runId: attempt.runId, role, prepared, invocation };
+      return { callId, ...prepared };
+    },
+    async dispatch({ prepared }) {
+      const record = currentPrepared;
+      if (!record || record.callId !== prepared.callId)
+        throw new Error("Native prepared call identity changed");
+      await sessionManager.appendCustomEntryAsync(DISPATCHED, { callId: record.callId });
+      try {
+        await required("dispatch", () =>
+          runner.runModelContextDispatch(
+            { ...record, ...record.invocation, sessionId: attempt.sessionId },
+            context,
+          ),
+        );
+      } catch (cause) {
+        // The provider has not been invoked while this callback is pending.
+        // Persist that fact before releasing any reservation, including after restart.
+        await sessionManager.appendCustomEntryAsync(NOT_DISPATCHED, { callId: record.callId });
+        await settleNotSent(record);
+        throw cause;
+      }
+    },
+    async accept({ prepared, output, auxiliary }) {
+      const record = currentPrepared;
+      if (!record || record.callId !== prepared.callId)
+        throw new Error("Native prepared call identity changed");
+      if (auxiliary)
+        await sessionManager.appendCustomEntryAsync(AUXILIARY_OUTPUT, {
+          callId: record.callId,
+          output,
+        });
+      const saved = savedResponse(record);
+      if (!saved)
+        throw new AgentHarnessPreflightError("The native response has not been durably saved");
+      await settle(record, saved.output, saved.entryId);
+    },
+  };
+  return () => {
+    agent.modelContext = previous;
+  };
+}
