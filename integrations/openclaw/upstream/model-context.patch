@@ -0,0 +1,256 @@
+import path from "node:path";
+import { expect, it, vi } from "vitest";
+import {
+  makeAssistantMessage,
+  createTurnSequenceStream,
+  model,
+} from "../../../../packages/agent-core/src/agent-loop.test-support.js";
+import { Agent } from "../../../../packages/agent-core/src/agent.js";
+import { runSummarizationCompletion } from "../../../../packages/agent-core/src/harness/compaction/summarization-completion.js";
+import { convertToLlm } from "../../../../packages/agent-core/src/harness/messages.js";
+import { replaceSessionEntry } from "../../../config/sessions/session-accessor.js";
+import { SessionManager } from "../../../plugin-sdk/agent-sessions.js";
+import { withOpenClawTestState } from "../../../test-utils/openclaw-test-state.js";
+import { installModelContextHandoff } from "./attempt.model-context.js";
+import type { EmbeddedRunAttemptParams } from "./types.js";
+
+const { runner } = vi.hoisted(() => ({
+  runner: {
+    hasHooks: () => true,
+    runModelContextPrepare: vi.fn(async (_event: unknown) => ({
+      view: { revision: 1 },
+      inputRefs: [
+        {
+          product: "nous",
+          installationId: "n",
+          subjectId: "s",
+          kind: "Material",
+          id: "private",
+          revision: 1,
+        },
+      ],
+      systemPromptAddition: "Known memory",
+    })),
+    runModelContextDispatch: vi.fn(async () => {}),
+    runModelContextAccept: vi.fn(
+      async (
+        event: unknown,
+        _context?: unknown,
+      ): Promise<{ outputRef?: unknown; selectedOutputRefs?: unknown[] } | undefined> => {
+        if (event && typeof event === "object" && "output" in event) {
+          const outputRef = {
+            product: "nous",
+            installationId: "n",
+            subjectId: "s",
+            kind: "Material",
+            id: "native-result",
+            revision: 1,
+          };
+          return {
+            outputRef,
+            selectedOutputRefs: [
+              { ...outputRef, selector: { kind: "node", nodeId: "/content/0/text" } },
+            ],
+          };
+        }
+      },
+    ),
+  },
+}));
+vi.mock("../../../plugins/hook-runner-global.js", () => ({ getGlobalHookRunner: () => runner }));
+
+it("reopens the native response and completes acceptance before another model call", async () => {
+  await withOpenClawTestState({ label: "model-context-handoff" }, async (state) => {
+    const target = {
+      agentId: "main",
+      sessionId: "handoff",
+      sessionKey: "agent:main:handoff",
+      storePath: path.join(state.agentDir("main"), "openclaw-agent.sqlite"),
+    };
+    await replaceSessionEntry(target, { sessionId: target.sessionId, updatedAt: 1 });
+    let manager = await SessionManager.openAsync(target, state.workspaceDir);
+    const attempt = {
+      runId: "task",
+      sessionId: target.sessionId,
+      sessionKey: target.sessionKey,
+      workspaceDir: state.workspaceDir,
+    } as EmbeddedRunAttemptParams;
+    const first = new Agent({ streamFn: createTurnSequenceStream([]) });
+    const cleanup = installModelContextHandoff({
+      agent: first,
+      attempt,
+      sessionManager: manager,
+      agentId: "main",
+    });
+    const summary = makeAssistantMessage([{ type: "text", text: "Saved native summary" }]);
+    const compacted = await runSummarizationCompletion({
+      messages: [{ role: "user", content: "Earlier work", timestamp: 1 }],
+      prompt: "Summarize",
+      model: { ...model, contextWindow: 128000 },
+      maxTokens: 100,
+      apiKey: "local-test",
+      errorLabel: "compaction",
+      runtime: {
+        completeSimple: async () => summary,
+        modelContext: first.modelContext,
+      },
+    });
+    expect(compacted).toEqual({ ok: true, value: "Saved native summary" });
+    expect(runner.runModelContextPrepare.mock.calls[0]?.[0]).toMatchObject({ role: "compaction" });
+    expect(
+      manager
+        .getBranch()
+        .some(
+          (entry) =>
+            entry.type === "custom" &&
+            entry.customType === "openclaw.model-context.auxiliary-output",
+        ),
+    ).toBe(true);
+    const rejected = await first.modelContext!.prepare({
+      model,
+      outputTokens: 100,
+      context: { messages: [] },
+    });
+    runner.runModelContextDispatch.mockRejectedValueOnce(new Error("Call budget exhausted"));
+    await expect(first.modelContext!.dispatch!({ prepared: rejected! })).rejects.toThrow(
+      "Required model context dispatch failed",
+    );
+    expect(runner.runModelContextAccept.mock.calls.at(-1)?.[0]).toMatchObject({
+      callId: rejected!.callId,
+      outcome: "not_sent",
+    });
+    const prepared = await first.modelContext!.prepare({
+      model,
+      outputTokens: 100,
+      context: { messages: [], tools: [] },
+    });
+    expect(prepared).toBeDefined();
+    await first.modelContext!.dispatch!({ prepared: prepared! });
+    const output = makeAssistantMessage([{ type: "text", text: "Already paid result" }]);
+    await manager.appendMessageAsync({
+      ...output,
+      modelContext: { callId: prepared!.callId, terminal: true, inputRefs: prepared!.inputRefs },
+    });
+    runner.runModelContextAccept.mockRejectedValueOnce(new Error("Nous temporarily unavailable"));
+    await expect(first.modelContext!.accept({ prepared: prepared!, output })).rejects.toThrow(
+      "Required model context accept failed",
+    );
+    cleanup();
+
+    manager = await SessionManager.openAsync(target, state.workspaceDir);
+    const resumed = new Agent({ streamFn: createTurnSequenceStream([]) });
+    const stop = installModelContextHandoff({
+      agent: resumed,
+      attempt,
+      sessionManager: manager,
+      agentId: "main",
+    });
+    try {
+      const next = await resumed.modelContext!.prepare({
+        model,
+        outputTokens: 100,
+        context: { messages: [], tools: [] },
+      });
+      expect(runner.runModelContextAccept).toHaveBeenCalledTimes(4);
+      expect(runner.runModelContextAccept.mock.calls[3]?.[0]).toMatchObject({
+        callId: prepared!.callId,
+        output: { content: output.content },
+      });
+      expect(runner.runModelContextAccept.mock.calls[3]?.[0]).toEqual(
+        runner.runModelContextAccept.mock.calls[2]?.[0],
+      );
+      const restoredOutput = manager
+        .getBranch()
+        .find(
+          (entry) =>
+            entry.type === "message" &&
+            entry.message.role === "assistant" &&
+            entry.message.modelContext?.callId === prepared!.callId,
+        );
+      expect(restoredOutput).toMatchObject({
+        message: {
+          modelContext: {
+            outputRef: { id: "native-result" },
+            selectedOutputRefs: [{ selector: { nodeId: "/content/0/text" } }],
+          },
+        },
+      });
+      const entries = manager.getBranch();
+      const accepted = entries.findIndex(
+        (entry) => entry.type === "custom" && entry.customType === "openclaw.model-context.settled",
+      );
+      expect(accepted).toBeGreaterThan(-1);
+      expect(
+        entries
+          .slice(accepted + 1)
+          .some(
+            (entry) =>
+              entry.type === "custom" && entry.customType === "openclaw.model-context.prepared",
+          ),
+      ).toBe(true);
+      await resumed.modelContext!.dispatch!({ prepared: next! });
+      await manager.appendMessageAsync({
+        ...output,
+        modelContext: { callId: next!.callId, terminal: false },
+      });
+      stop();
+      manager = await SessionManager.openAsync(target, state.workspaceDir);
+      const interrupted = new Agent({ streamFn: createTurnSequenceStream([]) });
+      const stopInterrupted = installModelContextHandoff({
+        agent: interrupted,
+        attempt,
+        sessionManager: manager,
+        agentId: "main",
+      });
+      try {
+        await expect(
+          interrupted.modelContext!.prepare({
+            model,
+            outputTokens: 100,
+            context: { messages: [], tools: [] },
+          }),
+        ).rejects.toThrow("Required model context recovery failed");
+        expect(runner.runModelContextAccept).toHaveBeenCalledTimes(4);
+      } finally {
+        stopInterrupted();
+      }
+      await manager.appendMessageAsync({
+        ...output,
+        stopReason: "error",
+        modelContext: { callId: next!.callId, terminal: true },
+      });
+      const unknown = new Agent({ streamFn: createTurnSequenceStream([]) });
+      const stopUnknown = installModelContextHandoff({
+        agent: unknown,
+        attempt,
+        sessionManager: manager,
+        agentId: "main",
+      });
+      try {
+        for (let check = 0; check < 2; check++)
+          await expect(
+            unknown.modelContext!.prepare({ model, outputTokens: 100, context: { messages: [] } }),
+          ).rejects.toThrow("Required model context recovery failed");
+        expect(runner.runModelContextAccept).toHaveBeenCalledTimes(5);
+      } finally {
+        stopUnknown();
+      }
+      const kept = await manager.appendMessageAsync({
+        role: "user",
+        content: "Continue later",
+        timestamp: 2,
+      });
+      await manager.appendCompactionAsync("Prior work summary", kept!, 100);
+      const projected = convertToLlm(manager.buildSessionContext().messages);
+      expect(
+        projected.some(
+          (message) =>
+            message.role === "user" &&
+            message.modelContext?.inputRefs.some((ref) => (ref as { id: string }).id === "private"),
+        ),
+      ).toBe(true);
+    } finally {
+      stop();
+    }
+  });
+});
diff --git a/src/agents/embedded-agent-runner/run/attempt.model-context.ts b/src/agents/embedded-agent-runner/run/attempt.model-context.ts
new file mode 100644
index 00000000..95cc756b
--- /dev/null
+++ b/src/agents/embedded-agent-runner/run/attempt.model-context.ts
@@ -0,0 +1,370 @@
+import { randomUUID } from "node:crypto";
+import type { AssistantMessage } from "@openclaw/llm-core";
+import { isProviderRefusalAssistantError } from "@openclaw/llm-core/diagnostics";
+import { getActiveDiagnosticTraceContext } from "../../../infra/diagnostic-trace-context.js";
+import { formatPropagatedDiagnosticTraceparent } from "../../../infra/diagnostic-trace-propagation.js";
+import { getGlobalHookRunner } from "../../../plugins/hook-runner-global.js";
+import type {
+  PluginHookAgentContext,
+  PluginHookModelContextPrepareResult,
+} from "../../../plugins/hook-types.js";
+import { AgentHarnessPreflightError } from "../../harness/errors.js";
+import { estimateTokens } from "../../runtime/index.js";
+import type { guardSessionManager } from "../../session-tool-result-guard-wrapper.js";
+import type { AgentSession } from "../../sessions/index.js";
+import { withSessionManagerWrite } from "../../sessions/session-manager-write-admission.js";
+import { rewriteTranscriptEntriesInSessionManager } from "../transcript-rewrite.js";
+import type { EmbeddedRunAttemptParams } from "./types.js";
+
+const PREPARED = "openclaw.model-context.prepared";
+const DISPATCHED = "openclaw.model-context.dispatched";
+const AUXILIARY_OUTPUT = "openclaw.model-context.auxiliary-output";
+const NOT_DISPATCHED = "openclaw.model-context.not-dispatched";
+const SETTLED = "openclaw.model-context.settled";
+
+type Prepared = {
+  callId: string;
+  runId: string;
+  role?: string;
+  prepared: PluginHookModelContextPrepareResult;
+  invocation: {
+    traceparent?: string;
+    provider: string;
+    model: string;
+    inputTokensEstimate: number;
+    outputTokens: number;
+  };
+};
+
+/** Install the required handoff on the provider boundary, outside compaction. */
+export function installModelContextHandoff(input: {
+  agent: AgentSession["agent"];
+  attempt: Pick<
+    EmbeddedRunAttemptParams,
+    "runId" | "sessionId" | "sessionKey" | "spawnedBy" | "workspaceDir" | "contextTokenBudget"
+  >;
+  sessionManager: ReturnType<typeof guardSessionManager>;
+  agentId: string;
+}): () => void {
+  const runner = getGlobalHookRunner();
+  if (!runner?.hasHooks("model_context_prepare")) {
+    return () => {};
+  }
+  const { agent, attempt, sessionManager } = input;
+  const previous = agent.modelContext;
+  const trace = getActiveDiagnosticTraceContext();
+  const traceparent = formatPropagatedDiagnosticTraceparent(trace);
+  const context: PluginHookAgentContext = {
+    trace,
+    agentId: input.agentId,
+    runId: attempt.runId,
+    sessionId: attempt.sessionId,
+    sessionKey: attempt.sessionKey,
+    parentSessionKey: attempt.spawnedBy ?? undefined,
+    workspaceDir: attempt.workspaceDir,
+    contextTokenBudget: attempt.contextTokenBudget,
+  };
+
+  const required = async <T>(phase: string, operation: () => Promise<T>): Promise<T> => {
+    try {
+      return await operation();
+    } catch (cause) {
+      throw new AgentHarnessPreflightError(`Required model context ${phase} failed`, {
+        cause,
+        userMessage:
+          "Model context handoff is waiting. Continue the existing task after its dependency recovers.",
+      });
+    }
+  };
+  let currentPrepared: Prepared | undefined;
+  const savedResponse = (record: Prepared, entries = sessionManager.getBranch()) => {
+    const start = entries.findIndex(
+      (entry) =>
+        entry.type === "custom" &&
+        entry.customType === PREPARED &&
+        (entry.data as Prepared).callId === record.callId,
+    );
+    const auxiliary = entries.find(
+      (entry) =>
+        entry.type === "custom" &&
+        entry.customType === AUXILIARY_OUTPUT &&
+        (entry.data as { callId: string }).callId === record.callId,
+    );
+    if (auxiliary?.type === "custom")
+      return {
+        output: (auxiliary.data as { output: AssistantMessage }).output,
+        entryId: auxiliary.id,
+      };
+    const fragments: { id: string; message: AssistantMessage }[] = [];
+    for (const candidate of entries.slice(start + 1)) {
+      if (candidate.type === "custom" && candidate.customType === PREPARED) break;
+      if (
+        candidate.type === "message" &&
+        candidate.message.role === "assistant" &&
+        candidate.message.modelContext?.callId === record.callId
+      )
+        fragments.push({ id: candidate.id, message: candidate.message });
+    }
+    const terminal = fragments.at(-1);
+    return terminal?.message.modelContext?.terminal
+      ? {
+          output: {
+            ...terminal.message,
+            content: fragments.flatMap((fragment) => fragment.message.content),
+          },
+          entryId: terminal.id,
+        }
+      : undefined;
+  };
+  const settleNotSent = async (record: Prepared) => {
+    await required("accept", () =>
+      runner.runModelContextAccept(
+        {
+          ...record,
+          traceparent: record.invocation.traceparent,
+          sessionId: attempt.sessionId,
+          outcome: "not_sent",
+        },
+        { ...context, runId: record.runId },
+      ),
+    );
+    await sessionManager.appendCustomEntryAsync(SETTLED, {
+      callId: record.callId,
+      outcome: "not_sent",
+    });
+  };
+  const settle = async (record: Prepared, output: AssistantMessage, entryId?: string) => {
+    const accepted = await required("accept", () =>
+      runner.runModelContextAccept(
+        {
+          ...record,
+          traceparent: record.invocation.traceparent,
+          sessionId: attempt.sessionId,
+          output,
+          ...(entryId ? { transcriptEntryId: entryId } : {}),
+        },
+        { ...context, runId: record.runId },
+      ),
+    );
+    if (accepted?.outputRef && entryId) {
+      const entry = sessionManager.getBranch().find((candidate) => candidate.id === entryId);
+      if (
+        entry?.type === "message" &&
+        entry.message.role === "assistant" &&
+        entry.message.modelContext
+      ) {
+        const metadata = {
+          ...entry.message.modelContext,
+          outputRef: accepted.outputRef,
+          selectedOutputRefs: accepted.selectedOutputRefs,
+        };
+        await withSessionManagerWrite(sessionManager, () =>
+          rewriteTranscriptEntriesInSessionManager({
+            sessionManager,
+            replacements: [{ entryId, message: { ...entry.message, modelContext: metadata } }],
+            preserveReplacementCompactionReplay: true,
+          }),
+        );
+        for (const message of agent.state.messages)
+          if (
+            message.role === "assistant" &&
+            message.modelContext?.callId === record.callId &&
+            message.modelContext.terminal
+          )
+            message.modelContext = metadata;
+      }
+    }
+    const unknown =
+      (output.stopReason === "error" || output.stopReason === "aborted") &&
+      !isProviderRefusalAssistantError(output);
+    await sessionManager.appendCustomEntryAsync(SETTLED, {
+      callId: record.callId,
+      ...(accepted?.outputRef
+        ? { outputRef: accepted.outputRef, selectedOutputRefs: accepted.selectedOutputRefs }
+        : {}),
+      outcome: unknown
+        ? "unknown"
+        : isProviderRefusalAssistantError(output)
+          ? "not_sent"
+          : "completed",
+    });
+    if (unknown) {
+      throw new AgentHarnessPreflightError(
+        `Model call ${record.callId} has an unknown provider outcome`,
+        {
+          userMessage:
+            "The provider outcome is unknown. Inspect this call before starting another model request.",
+        },
+      );
+    }
+  };
+
+  // Source and output remain in the native session. A response saved immediately
+  // before a crash is recovered from that session, then handed off once again.
+  const acceptPending = async () => {
+    const entries = sessionManager.getBranch();
+    const dispatched = new Set(
+      entries.flatMap((entry) =>
+        entry.type === "custom" && entry.customType === DISPATCHED
+          ? [(entry.data as { callId: string }).callId]
+          : [],
+      ),
+    );
+    const unresolved = entries.find(
+      (entry) =>
+        entry.type === "custom" &&
+        entry.customType === SETTLED &&
+        (entry.data as { outcome: string }).outcome === "unknown",
+    );
+    if (unresolved)
+      throw new AgentHarnessPreflightError(
+        "A previous native model call still has an unknown provider outcome",
+      );
+    const notDispatched = new Set(
+      entries.flatMap((entry) =>
+        entry.type === "custom" && entry.customType === NOT_DISPATCHED
+          ? [(entry.data as { callId: string }).callId]
+          : [],
+      ),
+    );
+    const settled = new Set(
+      entries.flatMap((entry) =>
+        entry.type === "custom" && entry.customType === SETTLED
+          ? [(entry.data as { callId: string }).callId]
+          : [],
+      ),
+    );
+    for (let index = 0; index < entries.length; index++) {
+      const entry = entries[index]!;
+      if (entry.type !== "custom" || entry.customType !== PREPARED) {
+        continue;
+      }
+      const record = entry.data as Prepared;
+      if (settled.has(record.callId)) {
+        continue;
+      }
+      if (notDispatched.has(record.callId)) {
+        await settleNotSent(record);
+        continue;
+      }
+      const saved = savedResponse(record, entries);
+      if (!saved) {
+        if (!dispatched.has(record.callId)) {
+          await sessionManager.appendCustomEntryAsync(SETTLED, {
+            callId: record.callId,
+            outcome: "not_sent",
+          });
+          continue;
+        }
+        throw new AgentHarnessPreflightError(
+          `model context call ${record.callId} has an unknown provider outcome; resolve it before continuing`,
+        );
+      }
+      await settle(record, saved.output, saved.entryId);
+    }
+  };
+
+  agent.modelContext = {
+    async prepare({ model, role, context: current, outputTokens, signal }) {
+      await required("recovery", acceptPending);
+      signal?.throwIfAborted();
+      const callId = `${attempt.runId}:${randomUUID()}`;
+      const baseEstimate =
+        current.messages.reduce((sum, message) => sum + estimateTokens(message), 0) +
+        estimateTokens({
+          role: "user",
+          content: `${current.systemPrompt ?? ""}\n${JSON.stringify(current.tools ?? [])}`,
+          timestamp: 0,
+        });
+      const contextLimit = attempt.contextTokenBudget ?? model.contextWindow;
+      if (typeof contextLimit !== "number" || !Number.isFinite(contextLimit) || contextLimit <= 0)
+        throw new AgentHarnessPreflightError(
+          `Native model ${model.provider}/${model.id} has no context limit`,
+        );
+      const prepared = await required("prepare", () =>
+        runner.runModelContextPrepare(
+          {
+            callId,
+            role,
+            traceparent,
+            runId: attempt.runId,
+            sessionId: attempt.sessionId,
+            provider: model.provider,
+            model: model.id,
+            contextLimit,
+            outputTokens,
+            inputTokensEstimate: baseEstimate,
+            transcriptCursor: sessionManager.getLeafEntry()?.id,
+            systemPrompt: current.systemPrompt,
+            messages: current.messages,
+            tools: current.tools ?? [],
+          },
+          context,
+        ),
+      );
+      if (!prepared) {
+        return undefined;
+      }
+      const invocation = {
+        traceparent,
+        provider: model.provider,
+        model: model.id,
+        outputTokens,
+        inputTokensEstimate:
+          baseEstimate +
+          estimateTokens({
+            role: "user",
+            content: prepared.systemPromptAddition ?? "",
+            timestamp: 0,
+          }) +
+          (prepared.messages ?? []).reduce((sum, message) => sum + estimateTokens(message), 0),
+      };
+      await sessionManager.appendCustomEntryAsync(PREPARED, {
+        callId,
+        runId: attempt.runId,
+        role,
+        prepared,
+        invocation,
+      } satisfies Prepared);
+      currentPrepared = { callId, runId: attempt.runId, role, prepared, invocation };
+      return { callId, ...prepared };
+    },
+    async dispatch({ prepared }) {
+      const record = currentPrepared;
+      if (!record || record.callId !== prepared.callId)
+        throw new Error("Native prepared call identity changed");
+      await sessionManager.appendCustomEntryAsync(DISPATCHED, { callId: record.callId });
+      try {
+        await required("dispatch", () =>
+          runner.runModelContextDispatch(
+            { ...record, ...record.invocation, sessionId: attempt.sessionId },
+            context,
+          ),
+        );
+      } catch (cause) {
+        // The provider has not been invoked while this callback is pending.
+        // Persist that fact before releasing any reservation, including after restart.
+        await sessionManager.appendCustomEntryAsync(NOT_DISPATCHED, { callId: record.callId });
+        await settleNotSent(record);
+        throw cause;
+      }
+    },
+    async accept({ prepared, output, auxiliary }) {
+      const record = currentPrepared;
+      if (!record || record.callId !== prepared.callId)
+        throw new Error("Native prepared call identity changed");
+      if (auxiliary)
+        await sessionManager.appendCustomEntryAsync(AUXILIARY_OUTPUT, {
+          callId: record.callId,
+          output,
+        });
+      const saved = savedResponse(record);
+      if (!saved)
+        throw new AgentHarnessPreflightError("The native response has not been durably saved");
+      await settle(record, saved.output, saved.entryId);
+    },
+  };
+  return () => {
+    agent.modelContext = previous;
+  };
+}
