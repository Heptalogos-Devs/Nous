+import { createEmptyPluginRegistry } from "../../../plugins/registry-empty.js";
+import { withOpenClawTestState } from "../../../test-utils/openclaw-test-state.js";
+import { installModelContextHandoff } from "./attempt.model-context.js";
+import type { EmbeddedRunAttemptParams } from "./types.js";
+
+const { runner } = vi.hoisted(() => ({
+  runner: {
+    hasHooks: () => true,
+    runModelContextPrepare: vi.fn(async (_event: unknown) => ({
+      view: { revision: 1 },
+      inputRefs: [
+        {
+          product: "nous",
+          installationId: "n",
+          subjectId: "s",
+          kind: "Material",
+          id: "private",
+          revision: 1,
+        },
+      ],
+      systemPromptAddition: "Known memory",
+    })),
+    runModelContextDispatch: vi.fn(async () => {}),
+    runModelContextAccept: vi.fn(
+      async (
+        event: unknown,
+        _context?: unknown,
+        _persist?: (accepted: {
+          outputRef?: unknown;
+          selectedOutputRefs?: unknown[];
+        }) => Promise<void>,
+      ): Promise<{ outputRef?: unknown; selectedOutputRefs?: unknown[] } | undefined> => {
+        if (event && typeof event === "object" && "output" in event) {
+          const outputRef = {
+            product: "nous",
+            installationId: "n",
+            subjectId: "s",
+            kind: "Material",
+            id: "native-result",
+            revision: 1,
+          };
+          const accepted = {
+            outputRef,
+            selectedOutputRefs: [
+              { ...outputRef, selector: { kind: "node", pointer: "/content/0/text" } },
+            ],
+          };
+          await _persist?.(accepted);
+          return accepted;
+        }
+      },
+    ),
+  },
+}));
+vi.mock("../../../plugins/hook-runner-global.js", () => ({ getGlobalHookRunner: () => runner }));
+
+it("reopens the native response and completes acceptance before another model call", async () => {
+  await withOpenClawTestState({ label: "model-context-handoff" }, async (state) => {
+    const target = {
+      agentId: "main",
+      sessionId: "handoff",
+      sessionKey: "agent:main:handoff",
+      storePath: path.join(state.agentDir("main"), "openclaw-agent.sqlite"),
+    };
+    await replaceSessionEntry(target, { sessionId: target.sessionId, updatedAt: 1 });
+    let manager = await SessionManager.openAsync(target, state.workspaceDir);
+    const attempt = {
+      runId: "task",
+      sessionId: target.sessionId,
+      sessionKey: target.sessionKey,
+      workspaceDir: state.workspaceDir,
+    } as EmbeddedRunAttemptParams;
+    const first = new Agent({ streamFn: createTurnSequenceStream([]) });
+    const cleanup = installModelContextHandoff({
+      agent: first,
+      attempt,
+      sessionManager: manager,
+      agentId: "main",
+    });
+    const summary = makeAssistantMessage([{ type: "text", text: "Saved native summary" }]);
+    const compacted = await runSummarizationCompletion({
+      messages: [{ role: "user", content: "Earlier work", timestamp: 1 }],
+      prompt: "Summarize",
+      model: { ...model, contextWindow: 128000 },
+      maxTokens: 100,
+      apiKey: "local-test",
+      errorLabel: "compaction",
+      runtime: {
+        completeSimple: async () => summary,
+        modelContext: first.modelContext,
+      },
+    });
+    expect(compacted).toEqual({ ok: true, value: "Saved native summary" });
+    expect(runner.runModelContextPrepare.mock.calls[0]?.[0]).toMatchObject({ role: "compaction" });
+    expect(
+      manager
+        .getBranch()
+        .some(
+          (entry) =>
+            entry.type === "custom" &&
+            entry.customType === "openclaw.model-context.auxiliary-output",
+        ),
+    ).toBe(true);
+    const rejected = await first.modelContext!.prepare({
+      model,
+      outputTokens: 100,
+      context: { messages: [] },
+    });
+    runner.runModelContextDispatch.mockRejectedValueOnce(new Error("Call budget exhausted"));
+    await expect(first.modelContext!.dispatch!({ prepared: rejected! })).rejects.toThrow(
+      "Required model context dispatch failed",
+    );
+    expect(runner.runModelContextAccept.mock.calls.at(-1)?.[0]).toMatchObject({
+      callId: rejected!.callId,
+      outcome: "not_sent",
+    });
+    const prepared = await first.modelContext!.prepare({
+      model,
+      outputTokens: 100,
+      context: { messages: [], tools: [] },
+    });
+    expect(prepared).toBeDefined();
+    await first.modelContext!.dispatch!({ prepared: prepared! });
+    const output = makeAssistantMessage([{ type: "text", text: "Already paid result" }]);
+    await manager.appendMessageAsync({
+      ...output,
+      modelContext: { callId: prepared!.callId, terminal: true, inputRefs: prepared!.inputRefs },
+    });
+    runner.runModelContextAccept.mockRejectedValueOnce(new Error("Nous temporarily unavailable"));
+    await expect(first.modelContext!.accept({ prepared: prepared!, output })).rejects.toThrow(
+      "Required model context accept failed",
+    );
+    cleanup();
+
+    manager = await SessionManager.openAsync(target, state.workspaceDir);
+    const resumed = new Agent({ streamFn: createTurnSequenceStream([]) });
+    const stop = installModelContextHandoff({
+      agent: resumed,
+      attempt,
+      sessionManager: manager,
+      agentId: "main",
+    });
+    try {
+      const next = await resumed.modelContext!.prepare({
+        model,
+        outputTokens: 100,
+        context: { messages: [], tools: [] },
+      });
+      expect(runner.runModelContextAccept).toHaveBeenCalledTimes(4);
+      expect(runner.runModelContextAccept.mock.calls[3]?.[0]).toMatchObject({
+        callId: prepared!.callId,
+        output: { content: output.content },
+      });
+      expect(runner.runModelContextAccept.mock.calls[3]?.[0]).toEqual(
+        runner.runModelContextAccept.mock.calls[2]?.[0],
+      );
+      const restoredOutput = manager
+        .getBranch()
+        .find(
+          (entry) =>
+            entry.type === "message" &&
+            entry.message.role === "assistant" &&
+            entry.message.modelContext?.callId === prepared!.callId,
+        );
+      expect(restoredOutput).toMatchObject({
+        message: {
+          modelContext: {
+            outputRef: { id: "native-result" },
+            selectedOutputRefs: [{ selector: { pointer: "/content/0/text" } }],
+          },
+        },
+      });
+      const entries = manager.getBranch();
+      const accepted = entries.findIndex(
+        (entry) => entry.type === "custom" && entry.customType === "openclaw.model-context.settled",
+      );
+      expect(accepted).toBeGreaterThan(-1);
+      expect(
+        entries
+          .slice(accepted + 1)
+          .some(
+            (entry) =>
+              entry.type === "custom" && entry.customType === "openclaw.model-context.prepared",
+          ),
+      ).toBe(true);
+      await resumed.modelContext!.dispatch!({ prepared: next! });
+      await manager.appendMessageAsync({
+        ...output,
+        modelContext: { callId: next!.callId, terminal: false },
+      });
+      stop();
+      manager = await SessionManager.openAsync(target, state.workspaceDir);
+      const interrupted = new Agent({ streamFn: createTurnSequenceStream([]) });
+      const stopInterrupted = installModelContextHandoff({
+        agent: interrupted,
+        attempt,
+        sessionManager: manager,
+        agentId: "main",
+      });
+      try {
+        await expect(
+          interrupted.modelContext!.prepare({
+            model,
+            outputTokens: 100,
+            context: { messages: [], tools: [] },
+          }),
+        ).rejects.toThrow("Required model context recovery failed");
+        expect(runner.runModelContextAccept).toHaveBeenCalledTimes(4);
+      } finally {
+        stopInterrupted();
+      }
+      await manager.appendMessageAsync({
+        ...output,
+        stopReason: "error",
+        modelContext: { callId: next!.callId, terminal: true },
+      });
+      const unknown = new Agent({ streamFn: createTurnSequenceStream([]) });
+      const stopUnknown = installModelContextHandoff({
+        agent: unknown,
+        attempt,
+        sessionManager: manager,
+        agentId: "main",
+      });
+      try {
+        for (let check = 0; check < 2; check++)
+          await expect(
+            unknown.modelContext!.prepare({ model, outputTokens: 100, context: { messages: [] } }),
+          ).rejects.toThrow("Required model context recovery failed");
+        expect(runner.runModelContextAccept).toHaveBeenCalledTimes(5);
+      } finally {
+        stopUnknown();
+      }
+      const kept = await manager.appendMessageAsync({
+        role: "user",
+        content: "Continue later",
+        timestamp: 2,
+      });
+      await manager.appendCompactionAsync("Prior work summary", kept!, 100);
+      const projected = convertToLlm(manager.buildSessionContext().messages);
+      expect(
+        projected.some(
+          (message) =>
+            message.role === "user" &&
+            message.modelContext?.inputRefs.some((ref) => (ref as { id: string }).id === "private"),
+        ),
+      ).toBe(true);
+    } finally {
+      stop();
+    }
+  });
+});
+
+it("saves known accounting before cognition failure and persists the accepted native output before late accounting", async () => {
+  await withOpenClawTestState({ label: "native-accepted-output" }, async (state) => {
+    const target = {
+      agentId: "main",
+      sessionId: "accepted-output",
