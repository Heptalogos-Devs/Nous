+it("reads actual prepared, dispatch and terminal facts through the native owner without transcript bodies", async () => {
+  await withOpenClawTestState({ scenario: "minimal" }, async (state) => {
+    const scope = {
+      agentId: "main",
+      sessionKey: "agent:main:model-call",
