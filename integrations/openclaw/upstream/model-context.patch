+      order: string[] = [];
+    const outputRef = {
+      product: "nous",
+      installationId: "fixture",
+      kind: "Material",
+      id: "saved-output",
+      revision: 1,
+    };
+    let captureFails = true,
+      physical = 0;
+    const registry = createEmptyPluginRegistry();
+    registry.typedHooks.push(
+      {
+        pluginId: "accounting",
+        source: "test",
+        hookName: "model_context_accept",
+        priority: 200,
+        conversationAccessAllowed: true,
+        handler: async () => {
+          order.push("cost");
+        },
+      },
+      {
+        pluginId: "cognition",
+        source: "test",
+        hookName: "model_context_accept",
+        priority: 100,
+        conversationAccessAllowed: true,
+        handler: async () => {
+          order.push("capture");
+          if (captureFails) throw new Error("capture unavailable");
+          return { outputRef };
+        },
+      },
+      {
+        pluginId: "accounting",
+        source: "test",
+        hookName: "model_context_accept",
+        priority: 0,
+        conversationAccessAllowed: true,
+        handler: async (event) => {
+          expect(event.accepted?.outputRef).toEqual(outputRef);
+          const reopened = await SessionManager.openAsync(target, state.workspaceDir);
+          const saved = reopened
+            .getBranch()
+            .findLast(
+              (entry) =>
+                entry.type === "custom" &&
+                entry.customType === "openclaw.model-context.auxiliary-output",
+            );
+          expect(
+            saved?.type === "custom" && (saved.data as { outputRef?: unknown }).outputRef,
+          ).toEqual(outputRef);
+          order.push("adopt");
+        },
+      },
+    );
+    const actual = createHookRunner(registry, { catchErrors: false }),
+      previous = runner.runModelContextAccept.getMockImplementation();
+    runner.runModelContextAccept.mockImplementation((event, ctx, persist) =>
+      actual.runModelContextAccept(event as never, ctx as never, persist),
+    );
+    const stop = installModelContextHandoff({
+      agent,
+      attempt: {
+        runId: "accepted-run",
+        sessionId: target.sessionId,
+        sessionKey: target.sessionKey,
+        workspaceDir: state.workspaceDir,
+      } as EmbeddedRunAttemptParams,
+      sessionManager: manager,
+      agentId: "main",
+    });
+    try {
+      const result = runSummarizationCompletion({
+        messages: [{ role: "user", content: "Earlier work", timestamp: 1 }],
+        prompt: "Summarize",
+        model: { ...model, contextWindow: 128000 },
+        maxTokens: 100,
+        apiKey: "fixture",
+        errorLabel: "compaction",
+        runtime: {
+          completeSimple: async () => {
+            physical++;
+            return makeAssistantMessage([{ type: "text", text: "Actual native response" }]);
+          },
+          modelContext: agent.modelContext,
+        },
+      });
+      await expect(result).rejects.toThrow("Required model context accept failed");
+      expect(order).toEqual(["cost", "capture"]);
+      expect(physical).toBe(1);
+      captureFails = false;
+      await agent.modelContext!.prepare({ model, outputTokens: 100, context: { messages: [] } });
+      expect(order).toEqual(["cost", "capture", "cost", "capture", "adopt"]);
+      expect(physical).toBe(1);
+    } finally {
+      stop();
+      if (previous) runner.runModelContextAccept.mockImplementation(previous);
+    }
+  });
+});
