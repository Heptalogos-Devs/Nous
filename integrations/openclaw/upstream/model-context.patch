+/** Read-only projection of one lifecycle-owned executable model; never discovers or resolves secrets. */
+import { createHash } from "node:crypto";
+import { getRuntimeConfig } from "../config/config.js";
+import { resolveRuntimeConfigCacheKey } from "../config/runtime-snapshot.js";
+import type { ProviderRuntimeModel } from "../plugins/provider-runtime-model.types.js";
+import { resolveDefaultModelForAgent } from "./model-selection-config.js";
+import { getModelRefStatus } from "./model-selection-shared.js";
+import { supportsModelTools } from "./model-tool-support.js";
+import { getPublishedPreparedModelCatalogOwnerSnapshot } from "./prepared-model-catalog.js";
+
+export type PublishedModelBinding = {
+  agentId: string;
+  provider: string;
+  modelId: string;
+  configRevision: string;
+  input: readonly string[];
+  reasoning: boolean;
+  supportsTools: boolean;
+  contextWindow?: number;
+  maxTokens?: number;
+};
+export function readPublishedModelBinding(input: {
+  agentId: string;
+  provider?: string;
+  modelId?: string;
+}): PublishedModelBinding {
+  const config = getRuntimeConfig(),
+    owner = getPublishedPreparedModelCatalogOwnerSnapshot({ agentId: input.agentId, config });
+  if (!owner?.isCurrent()) throw new Error("Native model owner is not currently published");
+  const defaultModel = resolveDefaultModelForAgent({
+    cfg: config,
+    agentId: input.agentId,
+    manifestPlugins: owner.metadataSnapshot,
+    allowPluginNormalization: false,
+  });
+  if ((input.provider === undefined) !== (input.modelId === undefined))
+    throw new Error("Native model selection requires both provider and modelId");
+  const provider = input.provider ?? defaultModel.provider;
+  const modelId = input.modelId ?? defaultModel.model;
+  const status = getModelRefStatus({
+    cfg: config,
+    agentId: input.agentId,
+    catalog: owner.modelCatalog.entries,
+    defaultProvider: defaultModel.provider,
+    defaultModel,
+    manifestPlugins: owner.metadataSnapshot,
+    ref: { provider, model: modelId },
+  });
+  if (!status.allowed)
+    throw new Error("Native model binding is outside this agent's current model policy");
+  let model = owner.findConfiguredRuntimeModel(provider, modelId);
+  if (!model) {
+    const candidates = [...(owner.readPublishedModels?.()?.values() ?? [])]
+      .flat()
+      .filter((row) => row.provider === provider && row.id === modelId);
+    const routes = new Map(candidates.map((row) => [JSON.stringify([row.api, row.baseUrl]), row]));
+    if (routes.size !== 1)
+      throw new Error("Native model binding has no unique published executable route");
+    model = routes.values().next().value as ProviderRuntimeModel | undefined;
+  }
+  if (!model || model.provider !== provider || model.id !== modelId)
+    throw new Error("Native model binding is not published for this resource");
+  const positive = (value: unknown) =>
+    typeof value === "number" && Number.isSafeInteger(value) && value > 0 ? value : undefined;
+  const facts = {
+    agentId: input.agentId,
+    provider: model.provider,
+    modelId: model.id,
