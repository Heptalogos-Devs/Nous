+      sessionId: scope.sessionId,
+      updatedAt: 1,
+      visibility: "shared",
+    });
+    const events = [
+      { type: "session", id: scope.sessionId },
+      {
+        type: "custom",
+        id: "prepared",
+        parentId: null,
+        customType: "openclaw.model-context.prepared",
+        data: {
+          runId,
+          callId,
+          role: "worker",
+          prepared: { view: { blocks: ["secret prompt body"] } },
+          invocation: {
+            provider: "native-provider",
+            model: "actual-model",
+            inputTokensEstimate: 42,
+            outputTokens: 128,
+          },
+        },
+      },
+    ];
+    await replaceTranscriptEvents(scope, events);
+    const context = requestContext({ agents: { entries: { main: {} } } });
+    await initializeSessionReadContext(context);
+    const read = async (sessionId = scope.sessionId) => {
+      const respond = vi.fn();
+      await sessionByKeyReadHandlers["sessions.modelCall"]!({
+        req: { type: "req", id: "call-facts", method: "sessions.modelCall" },
+        params: { key: scope.sessionKey, sessionId, runId, callId },
+        client: identifiedClient("synthetic-viewer"),
+        context,
+        respond,
+        isWebchatConnect: () => false,
+      });
+      expect(respond).toHaveBeenCalledOnce();
+      expect(respond.mock.calls[0]?.[0]).toBe(true);
+      return respond.mock.calls[0]?.[1];
+    };
+    expect(await read()).toMatchObject({
+      call: {
+        agentId: scope.agentId,
+        sessionKey: scope.sessionKey,
+        sessionId: scope.sessionId,
+        runId,
+        callId,
+        active: true,
+        dispatched: false,
+        notDispatched: false,
+        prepared: {
+          entryId: "prepared",
+          provider: "native-provider",
+          modelId: "actual-model",
+          inputTokensEstimate: 42,
+        },
+      },
+    });
+    expect(await read("another-session")).toEqual({ call: null });
+    await replaceTranscriptEvents(scope, [
+      ...events,
+      {
+        type: "custom",
+        id: "dispatch",
+        parentId: "prepared",
+        customType: "openclaw.model-context.dispatched",
+        data: { callId },
+      },
+      {
+        type: "message",
+        id: "terminal",
+        parentId: "dispatch",
+        message: {
+          role: "assistant",
+          content: [{ type: "text", text: "secret output body" }],
+          errorMessage: "secret provider body",
+          stopReason: "stop",
+          responseId: "provider-request",
+          modelContext: { callId, terminal: true },
+          usage: { input: 30, output: 12, cacheRead: 3, cacheWrite: 2, cost: { total: 999 } },
+        },
+      },
+      {
+        type: "custom",
+        id: "settled",
+        parentId: "terminal",
+        customType: "openclaw.model-context.settled",
+        data: { callId, outcome: "completed" },
+      },
+    ]);
+    const actual = await read();
+    expect(actual).toMatchObject({
+      call: {
+        dispatched: true,
+        terminal: {
+          entryId: "terminal",
+          providerRequestId: "provider-request",
+          usage: { input: 30, output: 12 },
+        },
+        settlement: { entryId: "settled", outcome: "completed" },
+      },
+    });
+    expect(JSON.stringify(actual)).not.toMatch(/secret|cost|999/);
+    const successor = { ...scope, sessionId: "successor-uuid" };
+    replaceSessionEntrySync(successor, {
+      sessionId: successor.sessionId,
+      previousSessionId: scope.sessionId,
+      updatedAt: 2,
+      visibility: "shared",
+    });
+    await replaceTranscriptEvents(successor, [{ type: "session", id: successor.sessionId }]);
+    expect(await read()).toMatchObject({
+      call: {
+        sessionId: scope.sessionId,
+        currentSessionId: successor.sessionId,
+        active: false,
+        terminal: { entryId: "terminal" },
+      },
+    });
+    const archived = await deleteSessionEntryLifecycle({
+      agentId: scope.agentId,
+      storePath: scope.storePath,
+      archiveTranscript: true,
+      target: { canonicalKey: scope.sessionKey, storeKeys: [scope.sessionKey] },
+    });
+    expect(archived.deleted).toBe(true);
+    const current = { ...scope, sessionId: "after-archive-uuid" };
+    replaceSessionEntrySync(current, {
+      sessionId: current.sessionId,
+      updatedAt: 3,
+      visibility: "shared",
+    });
+    await replaceTranscriptEvents(current, [{ type: "session", id: current.sessionId }]);
+    const recovered = await read();
+    expect(recovered).toMatchObject({
+      call: {
+        sessionId: scope.sessionId,
+        currentSessionId: current.sessionId,
+        active: false,
+        prepared: { provider: "native-provider" },
+        terminal: { entryId: "terminal" },
+      },
+    });
+    expect(JSON.stringify(recovered)).not.toMatch(/secret|cost|999/);
+  });
+});
