+import { isTranscriptEntryOnActivePathInTransaction } from "./session-accessor.sqlite-transcript-parent.js";
+import type { SessionTranscriptRuntimeTarget } from "./session-accessor.types.js";
+import type { SessionModelCallFacts } from "./session-transcript-hydration.types.js";
+import { transcriptEventJsonSql } from "./transcript-payload.js";
+
+/** Runs inside the transcript owner's canonical, deferred read transaction. */
+export function readSessionModelCallInTransaction(
+  database: OpenClawAgentReadOnlyDatabase,
+  target: SessionTranscriptRuntimeTarget,
+  request: { callId: string; runId: string; sessionId: string },
+): SessionModelCallFacts | null {
+  const currentSessionId = target.sessionId;
+  if (request.sessionId !== currentSessionId) {
+    const entry = readSessionEntryRow(database, target.sessionKey)?.entry;
+    const retained = entry && collectSessionStateIdsForEntry(entry).includes(request.sessionId);
+    const window = executeSqliteQueryTakeFirstSync(
+      database.db,
+      getSessionKysely(database.db)
+        .selectFrom("session_windows")
+        .select("session_id")
+        .where("session_key", "=", target.sessionKey)
+        .where("session_id", "=", request.sessionId)
+        .limit(1),
+    );
+    if (!retained && !window) return null;
+  }
+  target = { ...target, sessionId: request.sessionId };
+  const event = transcriptEventJsonSql(database.db);
+  // Project metadata inside the native payload owner. Prepared views, message bodies,
+  // provider errors, credentials and arbitrary custom data never leave this read.
+  const rows = iterateSqliteQuerySync(
+    database.db,
+    getSessionKysely(database.db)
+      .selectFrom("transcript_events")
+      .select([
+        /* kysely-allow-raw: select only the handoff's documented metadata paths. */
+        sql<string>`json_object(
+          'id', json_extract(${event}, '$.id'),
+          'type', json_extract(${event}, '$.type'),
+          'customType', json_extract(${event}, '$.customType'),
+          'runId', json_extract(${event}, '$.data.runId'),
+          'role', json_extract(${event}, '$.data.role'),
+          'provider', json_extract(${event}, '$.data.invocation.provider'),
+          'modelId', json_extract(${event}, '$.data.invocation.model'),
+          'inputTokensEstimate', json_extract(${event}, '$.data.invocation.inputTokensEstimate'),
+          'outputTokens', json_extract(${event}, '$.data.invocation.outputTokens'),
+          'inputRefs', json_extract(${event}, '$.data.prepared.inputRefs'),
+          'outcome', json_extract(${event}, '$.data.outcome'),
+          'terminal', json_extract(${event}, '$.message.modelContext.terminal'),
+          'outputRef', coalesce(json_extract(${event}, '$.message.modelContext.outputRef'), json_extract(${event}, '$.data.outputRef')),
+          'selectedOutputRefs', coalesce(json_extract(${event}, '$.message.modelContext.selectedOutputRefs'), json_extract(${event}, '$.data.selectedOutputRefs')),
+          'providerRefused', EXISTS (SELECT 1 FROM json_each(coalesce(json_extract(${event}, '$.message.diagnostics'), json_extract(${event}, '$.data.output.diagnostics'), '[]')) WHERE json_extract(value, '$.type') = 'provider_refusal'),
+          'stopReason', coalesce(json_extract(${event}, '$.message.stopReason'), json_extract(${event}, '$.data.output.stopReason')),
+          'providerRequestId', coalesce(json_extract(${event}, '$.message.responseId'), json_extract(${event}, '$.data.output.responseId')),
+          'usage', coalesce(json_extract(${event}, '$.message.usage'), json_extract(${event}, '$.data.output.usage'))
+        )`.as("facts"),
+      ])
+      .where("session_id", "=", target.sessionId)
+      .where((eb) =>
+        eb.or([
+          /* kysely-allow-raw: exact native call identity in custom handoff entries. */
+          sql<boolean>`json_extract(${event}, '$.data.callId') = ${request.callId}`,
+          /* kysely-allow-raw: exact native call identity in assistant fragments. */
+          sql<boolean>`json_extract(${event}, '$.message.modelContext.callId') = ${request.callId}`,
+        ]),
+      )
+      .orderBy("seq", "asc")
+      .limit(4097),
+  );
+  return collectSessionModelCallFacts(
+    [...rows].map((row) => JSON.parse(row.facts) as Record<string, unknown>),
+    target,
+    request,
+    currentSessionId,
+    (id) =>
+      request.sessionId === currentSessionId &&
+      isTranscriptEntryOnActivePathInTransaction(database, target.sessionId, id),
+  );
+}
+
+export function collectSessionModelCallFacts(
+  values: Iterable<Record<string, unknown>>,
+  target: SessionTranscriptRuntimeTarget,
+  request: { callId: string; runId: string },
+  currentSessionId: string,
+  isActive: (id: string) => boolean,
+): SessionModelCallFacts | null {
+  let facts: SessionModelCallFacts | null = null;
+  let count = 0;
+  for (const value of values) {
+    if (++count > 4096) throw new Error("Native model call exceeds the bounded metadata read");
+    const id = typeof value.id === "string" ? value.id : undefined;
+    if (!id) throw new Error("Native model call entry has no identity");
+    if (value.type === "custom" && value.customType === "openclaw.model-context.prepared") {
+      if (
+        facts ||
+        value.runId !== request.runId ||
+        !request.callId.startsWith(`${request.runId}:`)
+      ) {
+        throw new Error("Native model call prepared identity is inconsistent");
+      }
+      if (
+        typeof value.provider !== "string" ||
+        typeof value.modelId !== "string" ||
+        !Number.isSafeInteger(value.inputTokensEstimate) ||
+        Number(value.inputTokensEstimate) < 0 ||
+        !Number.isSafeInteger(value.outputTokens) ||
+        Number(value.outputTokens) < 1
+      ) {
+        throw new Error("Native model call prepared metadata is incomplete");
+      }
+      facts = {
+        agentId: target.agentId,
+        sessionId: target.sessionId,
+        currentSessionId,
+        sessionKey: target.sessionKey,
+        callId: request.callId,
+        runId: request.runId,
+        prepared: {
+          entryId: id,
+          provider: value.provider,
+          modelId: value.modelId,
+          ...(typeof value.role === "string" ? { role: value.role } : {}),
+          inputTokensEstimate: Number(value.inputTokensEstimate),
+          outputTokens: Number(value.outputTokens),
+          inputRefs: Array.isArray(value.inputRefs) ? value.inputRefs : [],
+        },
+        active: isActive(id),
+        dispatched: false,
+        notDispatched: false,
+      };
+      continue;
+    }
+    if (!facts) continue;
+    if (value.type === "custom") {
+      if (value.customType === "openclaw.model-context.dispatched") facts.dispatched = true;
+      if (value.customType === "openclaw.model-context.not-dispatched") facts.notDispatched = true;
+      if (
+        value.customType === "openclaw.model-context.settled" &&
+        ["completed", "not_sent", "unknown"].includes(String(value.outcome))
+      ) {
+        facts.settlement = {
+          entryId: id,
+          outcome: value.outcome as "completed" | "not_sent" | "unknown",
+        };
+      }
+    }
+    if (
+      (value.type === "message" && value.terminal === 1) ||
+      (value.type === "custom" && value.customType === "openclaw.model-context.auxiliary-output")
+    ) {
+      const usage =
+        typeof value.usage === "string" ? (JSON.parse(value.usage) as unknown) : value.usage;
+      const checkedUsage =
+        usage &&
+        typeof usage === "object" &&
+        ["input", "output", "cacheRead", "cacheWrite"].every(
+          (key) =>
+            Number.isSafeInteger((usage as Record<string, unknown>)[key]) &&
+            Number((usage as Record<string, unknown>)[key]) >= 0,
+        )
+          ? (Object.fromEntries(
+              ["input", "output", "cacheRead", "cacheWrite"].map((key) => [
+                key,
+                (usage as Record<string, number>)[key],
+              ]),
+            ) as NonNullable<SessionModelCallFacts["terminal"]>["usage"])
+          : undefined;
+      facts.terminal = {
+        entryId: id,
+        providerRefused: value.providerRefused === 1,
+        ...(value.outputRef ? { outputRef: value.outputRef } : {}),
+        ...(Array.isArray(value.selectedOutputRefs)
+          ? { selectedOutputRefs: value.selectedOutputRefs }
+          : {}),
+        ...(typeof value.stopReason === "string" ? { stopReason: value.stopReason } : {}),
+        ...(typeof value.providerRequestId === "string"
+          ? { providerRequestId: value.providerRequestId }
+          : {}),
+        ...(checkedUsage ? { usage: checkedUsage } : {}),
+      };
+    }
+  }
+  return facts;
+}
+
+/** Project an already decoded archived event inside the native archive owner. */
+export function projectSessionModelCallEvent(
+  event: unknown,
+  callId: string,
+): Record<string, unknown> | undefined {
+  if (!event || typeof event !== "object") return;
+  const e = event as Record<string, any>,
+    data = e.data ?? {},
+    message = e.message ?? {};
+  if (data.callId !== callId && message.modelContext?.callId !== callId) return;
+  const output =
+    e.customType === "openclaw.model-context.auxiliary-output" ? (data.output ?? {}) : message;
+  return {
+    id: e.id,
+    type: e.type,
+    customType: e.customType,
+    runId: data.runId,
+    role: data.role,
+    provider: data.invocation?.provider,
+    modelId: data.invocation?.model,
+    inputTokensEstimate: data.invocation?.inputTokensEstimate,
+    outputTokens: data.invocation?.outputTokens,
+    inputRefs: data.prepared?.inputRefs,
+    outcome: data.outcome,
+    terminal: message.modelContext?.terminal === true ? 1 : 0,
+    stopReason: output.stopReason,
+    providerRequestId: output.responseId,
+    providerRefused: output.diagnostics?.some((row: any) => row.type === "provider_refusal")
+      ? 1
+      : 0,
+    usage: output.usage,
+    outputRef: message.modelContext?.outputRef ?? data.outputRef,
+    selectedOutputRefs: message.modelContext?.selectedOutputRefs ?? data.selectedOutputRefs,
+  };
+}
