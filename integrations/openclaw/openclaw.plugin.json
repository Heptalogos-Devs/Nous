{
  "id": "nous-cognition",
  "name": "Nous Cognition",
  "categories": [
    "infrastructure"
  ],
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "baseURL": {
        "type": "string",
        "format": "uri"
      },
      "tokenEnv": {
        "default": "NOUS_SERVICE_TOKEN",
        "type": "string"
      },
      "installationId": {
        "type": "string"
      },
      "bindings": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "subjectId": {
              "type": "string"
            },
            "consumer": {
              "default": "worker",
              "type": "string",
              "enum": [
                "subject",
                "worker",
                "author",
                "maintenance"
              ]
            },
            "purpose": {
              "default": "worker",
              "type": "string"
            },
            "audience": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "billing": {
              "default": "nous",
              "type": "string",
              "enum": [
                "nous",
                "external"
              ]
            }
          },
          "required": [
            "subjectId"
          ]
        }
      },
      "modelResources": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "required": [
      "baseURL",
      "installationId",
      "bindings",
      "modelResources"
    ]
  }
}
