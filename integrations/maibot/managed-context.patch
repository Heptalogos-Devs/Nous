diff --git a/src/services/nous_context.py b/src/services/nous_context.py
new file mode 100644
index 000000000..42b3121c8
--- /dev/null
+++ b/src/services/nous_context.py
@@ -0,0 +1,128 @@
+"""Bind actual host model calls to prepared Nous context and measured wire inputs."""
+
+from collections.abc import AsyncIterator, Sequence
+from contextlib import asynccontextmanager
+from datetime import datetime, timezone
+from hashlib import sha256
+from typing import Any, Dict, List
+from uuid import uuid4
+
+import asyncio
+import json
+import os
+
+from nous_wave import HostInputMeasurement, SourceReadScope
+from nous_wave.contracts.context import ContextSegment, ContextUsage, EpistemicView
+from pydantic_core import to_json
+
+from src.common.runtime_loop import run_on_main_loop
+from src.llm_models.model_client.base_client import ResponseRequest
+from src.llm_models.payload_content.context_item import (
+    AssistantMessageItem, ContextImagePart, ContextItem, ContextItemBuilder, ContextItemMeta,
+    ContextTextPart, FunctionCallItem, FunctionCallOutputItem, ProviderActivityItem, ProviderOpaqueItem, ReasoningItem,
+    RoleType, SystemMessageItem, UserMessageItem,
+)
+from src.llm_models.request_snapshot import serialize_response_request_snapshot
+from src.services.memory_service import a_memorix_host_service
+
+
+def _bytes(value: object) -> bytes:
+    return to_json(value, bytes_mode="base64")
+
+
+def _snapshot(request: ResponseRequest, items: List[ContextItem]) -> bytes:
+    value = serialize_response_request_snapshot(request.copy_with(context_items=items))
+    # The host snapshot intentionally omits immutable provider replay; input
+    # admission includes those actual bytes as well as tools and format schemas.
+    value["provider_replay"] = [item.replay.materialize() for item in items
+        if isinstance(item, (AssistantMessageItem, FunctionCallItem, ReasoningItem, ProviderActivityItem, ProviderOpaqueItem)) and item.replay is not None]
+    return _bytes(value)
+
+
+def _reserved(wire: Dict[str, Any], request: ResponseRequest) -> int:
+    values = wire.get("request_kwargs", wire)
+    extra = values.get("extra_body") or {}
+    config = values.get("config") or {}
+    if hasattr(config, "model_dump"):
+        config = config.model_dump(mode="json")
+    value = extra.get("max_completion_tokens", extra.get("max_tokens",
+        values.get("max_output_tokens", config.get("max_output_tokens", values.get("max_tokens", request.max_tokens)))))
+    if not isinstance(value, int) or isinstance(value, bool) or value < 0:
+        raise ValueError("Managed model input requires the actual reserved output token limit")
+    return value
+
+
+@asynccontextmanager
+async def managed_response_request(request: ResponseRequest, task_name: str) -> AsyncIterator[ResponseRequest]:
+    configured = os.environ.get("NOUS_MODEL_CONTEXT_WINDOWS")
+    session_id = request.trace_context.session_id if request.trace_context is not None else ""
+    if not configured or not session_id:
+        yield request
+        return
+    windows = json.loads(configured)
+    model_name = request.model_info.name
+    window = windows.get(model_name, windows.get("*"))
+    if not isinstance(window, int) or isinstance(window, bool) or window <= 0:
+        raise ValueError(f"NOUS_MODEL_CONTEXT_WINDOWS requires the actual window for {model_name}")
+    base = [item for item in request.context_items if not item.meta.item_id.startswith("nous-context:")]
+    text = "\n".join(part.text for item in base
+        if isinstance(item, (SystemMessageItem, UserMessageItem, AssistantMessageItem, FunctionCallOutputItem))
+        for part in item.parts if isinstance(part, ContextTextPart))[-8192:]
+    image_count = sum(isinstance(part, ContextImagePart) for item in base
+        if isinstance(item, (SystemMessageItem, UserMessageItem, AssistantMessageItem)) for part in item.parts)
+    image_bounds = json.loads(os.environ.get("NOUS_MODEL_IMAGE_TOKEN_BOUNDS", "{}"))
+    image_bound = image_bounds.get(model_name, image_bounds.get("*"))
+    if image_count and (not isinstance(image_bound, int) or image_bound <= 0):
+        raise ValueError(f"Configure the model's image token upper bound for {model_name}")
+    adapter = a_memorix_host_service
+    binding = adapter.client.managed(namespace_id=adapter.namespace_id, subject_id=adapter.subject_id,
+        session_id=session_id, consumer_id="maibot", instance_id=request.logical_turn_id + ":" + uuid4().hex,
+        source_read=SourceReadScope(subject_id=adapter.subject_id, origin_conversation_refs=(session_id,)))
+    history_generation = sha256(_snapshot(request, base)).hexdigest()
+    invocation_id = request.logical_turn_id + ":" + uuid4().hex
+    admitted = False
+    applied = None
+    try:
+        prepared = await run_on_main_loop(binding.prepare(usage=ContextUsage(purpose=task_name or "model-call", intent=text),
+            max_items=64, max_text_bytes=65536))
+
+        def render(items: List[ContextItem], segments: Sequence[ContextSegment], usage: ContextUsage, view: EpistemicView) -> List[ContextItem]:
+            del usage, view
+            if not segments:
+                return items
+            payload = json.dumps([segment.model_dump(mode="json") for segment in segments], ensure_ascii=False)
+            item = ContextItemBuilder().set_role(RoleType.System).set_meta(ContextItemMeta.create(
+                item_id="nous-context:" + prepared.preparation_id, logical_turn_id=request.logical_turn_id)).add_text_content(
+                "以下是已授权的上下文。保留sources、epistemic与authority中的来源和归因；任务指令、来源记载和Steward推断分别使用。\n" + payload).build()
+            return [item, *items]
+
+        applied = binding.apply(base, prepared, render, lambda items: _snapshot(request, items))
+
+        @asynccontextmanager
+        async def before_send(wire: Dict[str, Any]) -> AsyncIterator[None]:
+            nonlocal admitted
+            if not admitted:
+                measurement = HostInputMeasurement(input_tokens=len(_bytes(wire)) + image_count * (image_bound or 0),
+                    reserved_output_tokens=_reserved(wire, request), context_window_tokens=window,
+                    source="maibot actual provider wire UTF-8 byte upper bound plus configured image bound")
+                await run_on_main_loop(binding.admit(applied, invocation_id=invocation_id,
+                    history_generation=history_generation, measurement=measurement))
+                admitted = True
+            yield
+
+        actual = request.copy_with(context_items=applied.input, admission_context=before_send)
+        try:
+            yield actual
+        except BaseException as error:
+            if admitted:
+                outcome = "cancelled" if isinstance(error, asyncio.CancelledError) else "failed"
+                await asyncio.shield(run_on_main_loop(binding.report(applied, invocation_id=invocation_id,
+                    outcome=outcome, occurred_at=datetime.now(timezone.utc))))
+            raise
+        else:
+            if not admitted:
+                raise RuntimeError("The model adapter did not measure and admit its actual provider wire input")
+            await run_on_main_loop(binding.report(applied, invocation_id=invocation_id,
+                outcome="completed", occurred_at=datetime.now(timezone.utc)))
+    finally:
+        await asyncio.shield(run_on_main_loop(binding.close()))
