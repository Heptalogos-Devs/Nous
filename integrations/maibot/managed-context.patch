diff --git a/src/services/nous_context.py b/src/services/nous_context.py
new file mode 100644
--- /dev/null
+++ b/src/services/nous_context.py
@@ -0,0 +1,349 @@
+"""Apply authorized cognition to actual MaiBot inputs without rewriting history."""
+
+import asyncio
+import json
+import os
+from collections.abc import AsyncGenerator, Sequence
+from contextlib import asynccontextmanager
+from datetime import datetime, timezone
+from hashlib import sha256
+from typing import Any
+from uuid import uuid4
+
+from nous_wave import HostInputMeasurement, SourceReadScope
+from nous_wave.contracts.context import (
+    ContextInvocationOutput,
+    ContextSegment,
+    ContextUsage,
+    EpistemicView,
+)
+from nous_wave.errors import NousError
+from pydantic_core import to_json
+
+from src.chat.message_receive.chat_manager import chat_manager
+from src.common.runtime_loop import run_on_main_loop
+from src.llm_models.model_client.base_client import APIResponse, ResponseRequest
+from src.llm_models.payload_content.context_item import (
+    AssistantMessageItem,
+    ContextImagePart,
+    ContextItem,
+    ContextItemBuilder,
+    ContextItemMeta,
+    ContextTextPart,
+    FunctionCallItem,
+    FunctionCallOutputItem,
+    ProviderActivityItem,
+    ProviderOpaqueItem,
+    ReasoningItem,
+    RoleType,
+    SystemMessageItem,
+    UserMessageItem,
+)
+from src.llm_models.request_snapshot import serialize_response_request_snapshot
+from src.services.memory_service import a_memorix_host_service
+
+
+def invalid(message: str) -> NousError:
+    return NousError({"code": "managed_context_input_invalid", "message": message})
+
+
+def _bytes(value: object) -> bytes:
+    return to_json(value, bytes_mode="base64")
+
+
+def _snapshot(request: ResponseRequest, items: list[ContextItem]) -> bytes:
+    value = serialize_response_request_snapshot(request.copy_with(context_items=items))
+    value["provider_replay"] = [
+        item.replay.materialize()
+        for item in items
+        if isinstance(
+            item,
+            (
+                AssistantMessageItem,
+                FunctionCallItem,
+                ReasoningItem,
+                ProviderActivityItem,
+                ProviderOpaqueItem,
+            ),
+        )
+        and item.replay is not None
+    ]
+    return _bytes(value)
+
+
+def _reserved(wire: dict[str, Any], request: ResponseRequest) -> int:
+    values = wire.get("request_kwargs", wire)
+    extra = values.get("extra_body") or {}
+    config = values.get("config") or {}
+    if hasattr(config, "model_dump"):
+        config = config.model_dump(mode="json")
+    value = extra.get(
+        "max_completion_tokens",
+        extra.get(
+            "max_tokens",
+            values.get(
+                "max_output_tokens",
+                config.get(
+                    "max_output_tokens", values.get("max_tokens", request.max_tokens)
+                ),
+            ),
+        ),
+    )
+    if not isinstance(value, int) or isinstance(value, bool) or value < 0:
+        raise invalid(
+            "Managed model input requires the actual reserved output token limit"
+        )
+    return value
+
+
+async def _owned_cleanup(work) -> None:
+    task = asyncio.create_task(work)
+    cancelled = None
+    while not task.done():
+        try:
+            await asyncio.shield(task)
+        except asyncio.CancelledError as error:
+            cancelled = error
+    task.result()
+    if cancelled is not None:
+        raise cancelled
+
+
+class ManagedCall:
+    def __init__(self, request: ResponseRequest):
+        self.request = request
+        self.binding = None
+        self.applied = None
+        self.pending: str | None = None
+        self.sent = 0
+
+    async def report(
+        self, outcome: str, output: ContextInvocationOutput | None = None
+    ) -> None:
+        if self.pending is None:
+            return
+        invocation = self.pending
+        self.pending = None
+        await run_on_main_loop(
+            self.binding.report(
+                self.applied,
+                invocation_id=invocation,
+                outcome=outcome,
+                occurred_at=datetime.now(timezone.utc),
+                output=output,
+            )
+        )
+
+    async def complete(self, response: APIResponse) -> None:
+        if self.binding is None:
+            return
+        if self.pending is None:
+            raise invalid(
+                "The model adapter did not admit its actual provider wire input"
+            )
+        trace = response.generation_trace
+        await self.report(
+            "completed",
+            ContextInvocationOutput(
+                model=trace.model
+                if trace
+                else self.request.model_info.model_identifier,
+                provider=trace.provider if trace else None,
+                response_id=trace.response_id if trace else None,
+                status=trace.status if trace else None,
+                output_item_ids=tuple(
+                    item.meta.item_id for item in response.output_items
+                ),
+                tool_call_ids=tuple(call.call_id for call in response.tool_calls or ()),
+            ),
+        )
+
+
+@asynccontextmanager
+async def managed_response_request(
+    request: ResponseRequest, task_name: str
+) -> AsyncGenerator[ManagedCall]:
+    call = ManagedCall(request)
+    configured = os.environ.get("NOUS_MODEL_CONTEXT_WINDOWS")
+    trace = request.trace_context
+    session_id = trace.session_id if trace is not None else ""
+    if not configured or not session_id:
+        yield call
+        return
