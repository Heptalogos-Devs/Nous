+// ParseAudioChatTranscriptionUsage checks presence before the shared integer DTO
+// loses it. An incomplete pair is unknown usage, not an upstream zero count.
+func ParseAudioChatTranscriptionUsage(raw []byte) (*dto.Usage, error) {
+	raw = bytes.TrimSpace(raw)
+	if len(raw) == 0 || bytes.Equal(raw, []byte("null")) {
+		return nil, nil
+	}
+	var counters struct {
+		Prompt     *int `json:"prompt_tokens"`
+		Completion *int `json:"completion_tokens"`
+		Input      *int `json:"input_tokens"`
+		Output     *int `json:"output_tokens"`
+		Total      *int `json:"total_tokens"`
+	}
+	if err := common.Unmarshal(raw, &counters); err != nil {
+		return nil, err
+	}
+	if (counters.Prompt == nil || counters.Completion == nil) && (counters.Input == nil || counters.Output == nil) {
+		return nil, nil
+	}
+	var usage dto.Usage
+	if err := common.Unmarshal(raw, &usage); err != nil {
+		return nil, err
+	}
+	input, output := usage.PromptTokens, usage.CompletionTokens
+	if input == 0 && usage.InputTokens != 0 {
+		input = usage.InputTokens
+	}
+	if output == 0 && usage.OutputTokens != 0 {
+		output = usage.OutputTokens
+	}
+	if counters.Total != nil && *counters.Total >= 0 && input >= 0 && output >= 0 &&
+		(input > *counters.Total || output != *counters.Total-input) {
+		return nil, nil
+	}
+	return &usage, nil
+}
