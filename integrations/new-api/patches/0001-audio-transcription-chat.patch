+package openai
+
+import (
+	"errors"
+	"math"
+
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/constant"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	"github.com/QuantumNous/new-api/relaykit/dto"
+	"github.com/QuantumNous/new-api/service"
+	"github.com/gin-gonic/gin"
+)
+
+// transcriptionResponseUsage accepts both standard transcription usage variants.
+// Duration units retain the native ASR convention; they never become Chat tokens.
+func transcriptionResponseUsage(c *gin.Context, info *relaycommon.RelayInfo, body []byte, responseFormat string) (*dto.Usage, error) {
+	var response struct {
+		Usage *struct {
+			dto.Usage
+			Type              string                 `json:"type"`
+			Seconds           *float64               `json:"seconds"`
+			InputTokenDetails *dto.InputTokenDetails `json:"input_token_details"`
+			Prompt            *int                   `json:"prompt_tokens"`
+			Completion        *int                   `json:"completion_tokens"`
+			Input             *int                   `json:"input_tokens"`
+			Output            *int                   `json:"output_tokens"`
+			Total             *int                   `json:"total_tokens"`
+		} `json:"usage"`
+	}
+	decodeErr := common.Unmarshal(body, &response)
+	if decodeErr != nil && (responseFormat == "" || responseFormat == "json" || responseFormat == "verbose_json") {
+		return nil, errors.New("invalid upstream transcription JSON response or token counters")
+	}
+	if decodeErr == nil && response.Usage != nil {
+		reported := response.Usage
+		if reported.Type == "duration" {
+			if reported.Seconds == nil {
+				return nil, errors.New("upstream transcription duration usage is missing seconds")
+			}
+			if err := service.ValidateAudioTranscriptionSeconds(*reported.Seconds); err != nil {
+				return nil, err
+			}
+			units, clamp := common.QuotaRoundChecked(math.Ceil(*reported.Seconds) / 60 * 1000)
+			if info.QuotaClamp == nil {
+				info.QuotaClamp = clamp
+			}
+			service.RecordAudioTranscriptionBillingMetadata(c, info, "native_asr", "upstream_duration", reported.Seconds)
+			return &dto.Usage{PromptTokens: units, TotalTokens: units}, nil
+		}
+		if reported.Type != "" && reported.Type != "tokens" {
+			return nil, errors.New("unsupported upstream transcription usage type")
+		}
+		if reported.Type == "tokens" && (reported.Input == nil || reported.Output == nil || reported.Total == nil) {
+			return nil, errors.New("upstream transcription token usage is missing required counters")
+		}
+		if reported.Input == nil && reported.Output == nil && reported.Total == nil && reported.Prompt == nil && reported.Completion == nil {
+			return transcriptionEstimatedUsage(c, info), nil
+		}
+		for target, value := range map[*int]*int{
+			&reported.Usage.PromptTokens: reported.Prompt, &reported.Usage.CompletionTokens: reported.Completion,
+			&reported.Usage.InputTokens: reported.Input, &reported.Usage.OutputTokens: reported.Output,
+			&reported.Usage.TotalTokens: reported.Total,
+		} {
+			if value != nil {
+				*target = *value
+			}
+		}
+		if reported.InputTokenDetails != nil {
+			reported.Usage.InputTokensDetails = reported.InputTokenDetails
+		}
+		usage, err := service.NormalizeAudioTranscriptionUsage(info, &reported.Usage)
+		if err != nil {
+			return nil, err
+		}
+		service.RecordAudioTranscriptionBillingMetadata(c, info, "native_asr", "upstream_tokens", nil)
+		return usage, nil
+	}
+	return transcriptionEstimatedUsage(c, info), nil
+}
+
+func transcriptionEstimatedUsage(c *gin.Context, info *relaycommon.RelayInfo) *dto.Usage {
+	common.SetContextKey(c, constant.ContextKeyLocalCountTokens, true)
+	service.RecordAudioTranscriptionBillingMetadata(c, info, "native_asr", "estimated_duration", nil)
+	estimate := info.GetEstimatePromptTokens()
+	return &dto.Usage{PromptTokens: estimate, TotalTokens: estimate}
+}
