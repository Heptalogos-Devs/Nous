+func TestAudioTranscriptionChatConversionRequestAndResponse(t *testing.T) {
+	for _, tc := range []struct{ name, usage, expectedUsage string }{
+		{"prompt_completion", `{"prompt_tokens":24,"completion_tokens":5,"total_tokens":29,"prompt_tokens_details":{"audio_tokens":20}}`, `{"type":"tokens","input_tokens":24,"output_tokens":5,"total_tokens":29,"input_token_details":{"audio_tokens":20}}`},
+		{"input_output", `{"input_tokens":24,"output_tokens":5,"total_tokens":29,"input_tokens_details":{"audio_tokens":20}}`, `{"type":"tokens","input_tokens":24,"output_tokens":5,"total_tokens":29,"input_token_details":{"audio_tokens":20}}`},
+		{"unreported", `null`, ""},
+		{"empty_usage", `{}`, ""},
+		{"explicit_zero", `{"prompt_tokens":0,"completion_tokens":0,"total_tokens":0}`, `{"type":"tokens","input_tokens":0,"output_tokens":0,"total_tokens":0}`},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			c, recorder, info := audioTranscriptionRequest(t, map[string]string{"language": "en", "prompt": "Catalogue"}, nil)
+			called := false
+			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				called = true
+				require.Equal(t, "/v1/chat/completions", r.URL.Path)
+				require.Equal(t, "Bearer integration-test-key", r.Header.Get("Authorization"))
+				require.Equal(t, "application/json", r.Header.Get("Content-Type"))
+				var request dto.GeneralOpenAIRequest
+				require.NoError(t, common.DecodeJson(r.Body, &request))
+				require.Contains(t, request.Messages[0].StringContent(), "verbatim")
+				require.Contains(t, request.Messages[1].ParseContent()[0].Text, "Catalogue")
+				audio := request.Messages[1].ParseContent()[1].GetInputAudio()
+				decoded, err := base64.StdEncoding.DecodeString(audio.Data)
+				require.NoError(t, err)
+				require.Equal(t, "RIFFtestWAVE", string(decoded))
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = io.WriteString(w, `{"model":"audio-model-revision","choices":[{"index":0,"message":{"role":"assistant","content":"Sample words repeat repeat."},"finish_reason":"stop"}],"usage":`+tc.usage+`}`)
+			}))
+			defer upstream.Close()
+			info.ChannelBaseUrl = upstream.URL
+			adaptor := &Adaptor{}
+			body, err := adaptor.ConvertAudioRequest(c, info, dto.AudioRequest{Model: "audio-model", ResponseFormat: "json"})
+			require.NoError(t, err)
+			response, err := adaptor.DoRequest(c, info, body)
+			require.NoError(t, err)
+			usage, apiErr := adaptor.DoResponse(c, response.(*http.Response), info)
+			require.Nil(t, apiErr)
+			require.True(t, called)
+			require.NotNil(t, usage)
+			expected := `{"text":"Sample words repeat repeat.","transcription_backend":"audio_chat","model":"audio-model-revision"`
+			if tc.expectedUsage != "" {
+				expected += `,"usage":` + tc.expectedUsage
+			}
+			expected += "}"
+			require.JSONEq(t, expected, recorder.Body.String())
+			require.Equal(t, "/v1/audio/transcriptions", c.Request.URL.Path)
+			require.Equal(t, relayconstant.RelayModeAudioTranscription, info.RelayMode)
+		})
+	}
+}
