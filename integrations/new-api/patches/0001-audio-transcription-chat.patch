+func appendAudioTranscriptionBillingInfo(c *gin.Context, info *relaycommon.RelayInfo, other *model.LogOther) {
+	state := transcriptionBillingStateFor(c, info)
+	if state == nil {
+		return
+	}
+	other.SetPublic("transcription_backend", state.backend)
+	if state.source != "" {
+		other.SetPublic("transcription_usage_source", state.source)
+	}
+	if state.seconds != nil && !math.IsNaN(*state.seconds) && !math.IsInf(*state.seconds, 0) {
+		other.SetPublic("transcription_audio_seconds", *state.seconds)
+	}
+	if usage := state.partialUsage; usage != nil {
+		other.SetAdmin("transcription_partial_usage", map[string]int{
+			"input_tokens": usage.PromptTokens, "output_tokens": usage.CompletionTokens,
+		})
+	}
+}
