+// NormalizeAudioTranscriptionUsage preserves upstream totals and fills the text
+// remainder expected by the existing audio settlement path.
+func NormalizeAudioTranscriptionUsage(info *relaycommon.RelayInfo, reported *dto.Usage) (*dto.Usage, error) {
+	if reported == nil {
+		return nil, nil
+	}
+	usage := *reported
+	if usage.PromptTokens == 0 && usage.InputTokens != 0 {
+		usage.PromptTokens = usage.InputTokens
+	}
+	if usage.CompletionTokens == 0 && usage.OutputTokens != 0 {
+		usage.CompletionTokens = usage.OutputTokens
+	}
+	if usage.InputTokensDetails != nil && usage.PromptTokensDetails.AudioTokens == 0 {
+		usage.PromptTokensDetails.AudioTokens = usage.InputTokensDetails.AudioTokens
+	}
+	if usage.OutputTokensDetails != nil && usage.CompletionTokenDetails.AudioTokens == 0 {
+		usage.CompletionTokenDetails.AudioTokens = usage.OutputTokensDetails.AudioTokens
+	}
+	counts := []*int{&usage.PromptTokens, &usage.CompletionTokens, &usage.TotalTokens,
+		&usage.InputTokens, &usage.OutputTokens, &usage.PromptCacheHitTokens,
+		&usage.PromptTokensDetails.AudioTokens, &usage.CompletionTokenDetails.AudioTokens,
+		&usage.PromptTokensDetails.CachedTokens, &usage.PromptTokensDetails.CachedCreationTokens,
+		&usage.PromptTokensDetails.CacheWriteTokens, &usage.PromptTokensDetails.ImageTokens,
+		&usage.CompletionTokenDetails.ImageTokens, &usage.CompletionTokenDetails.ReasoningTokens,
+		&usage.ClaudeCacheCreation5mTokens, &usage.ClaudeCacheCreation1hTokens}
+	for _, value := range counts {
+		if *value < 0 {
+			return nil, errors.New("upstream transcription usage contains a negative token count")
+		}
+		bounded, clamp := common.QuotaFromFloatChecked(float64(*value))
+		noteQuotaClamp(info, clamp)
+		*value = bounded
+	}
+	if usage.PromptTokensDetails.AudioTokens > usage.PromptTokens || usage.CompletionTokenDetails.AudioTokens > usage.CompletionTokens {
+		return nil, errors.New("upstream transcription audio usage exceeds its token total")
+	}
+	usage.PromptTokensDetails.TextTokens = usage.PromptTokens - usage.PromptTokensDetails.AudioTokens
+	usage.CompletionTokenDetails.TextTokens = usage.CompletionTokens - usage.CompletionTokenDetails.AudioTokens
+	if usage.TotalTokens == 0 && (usage.PromptTokens != 0 || usage.CompletionTokens != 0) {
+		var clamp *common.QuotaClamp
+		usage.TotalTokens, clamp = common.QuotaFromFloatChecked(float64(usage.PromptTokens) + float64(usage.CompletionTokens))
+		noteQuotaClamp(info, clamp)
+	}
+	return &usage, nil
+}
+
+// RecordAudioTranscriptionBillingMetadata records quantities and their provenance,
+// never uploaded audio, prompts, credentials or transcript text.
+func RecordAudioTranscriptionBillingMetadata(c *gin.Context, info *relaycommon.RelayInfo, backend, source string, seconds *float64) {
+	state := transcriptionBillingStateFor(c, info)
+	if state == nil {
+		state = &transcriptionBillingState{owner: info}
+		c.Set(transcriptionBillingContextKey, state)
+	}
+	state.backend, state.source, state.seconds = backend, source, seconds
+}
+
+// FinalizeAudioChatTranscriptionUsage returns billable token consumption even
+// when a delivered stream later fails. Request-priced failures keep refund semantics.
+func FinalizeAudioChatTranscriptionUsage(c *gin.Context, info *relaycommon.RelayInfo, reported *dto.Usage, text string, terminalError *types.NewAPIError) (*dto.Usage, *types.NewAPIError) {
+	if terminalError == nil && c.Request.Context().Err() != nil {
+		terminalError = types.NewErrorWithStatusCode(c.Request.Context().Err(), types.ErrorCodeDoRequestFailed, 499, types.ErrOptionWithSkipRetry())
+	}
+	if terminalError != nil {
+		terminalError = types.NewError(terminalError, terminalError.GetErrorCode(), types.ErrOptionWithSkipRetry())
+		if info.StreamStatus == nil {
+			info.StreamStatus = relaycommon.NewStreamStatus()
+		}
+		if c.Request.Context().Err() != nil {
+			info.StreamStatus.MarkCancelled()
+		} else {
+			info.StreamStatus.MarkFailed(string(terminalError.GetErrorCode()), string(terminalError.GetErrorType()), terminalError.StatusCode)
+		}
+	}
+	source := "upstream_tokens"
+	usage, err := NormalizeAudioTranscriptionUsage(info, reported)
+	if err != nil {
+		return nil, types.NewErrorWithStatusCode(err, types.ErrorCodeBadResponseBody, http.StatusBadGateway, types.ErrOptionWithSkipRetry())
+	}
+	if usage == nil {
+		source = "local_estimate"
+		if terminalError != nil && text == "" {
+			RecordAudioTranscriptionBillingMetadata(c, info, "audio_chat", source, nil)
+			return nil, terminalError
+		}
+		usage = ResponseText2Usage(c, text, info.GetBillingModelName(), info.GetEstimatePromptTokens())
+	} else {
+		common.SetContextKey(c, constant.ContextKeyLocalCountTokens, false)
+	}
+	RecordAudioTranscriptionBillingMetadata(c, info, "audio_chat", source, nil)
+	if terminalError != nil {
+		state := transcriptionBillingStateFor(c, info)
+		state.partialUsage = usage
+		requestPriced := info.PriceData.UsePrice
+		if info.TieredBillingSnapshot != nil {
+			snapshot := info.TieredBillingSnapshot
+			used := billingexpr.UsedVarsByHash(snapshot.ExprString, snapshot.ExprHash)
+			_, _, result := TryTieredSettle(info, BuildTieredTokenParams(usage, false, used))
+			requestPriced = isFixedPriceSettlement(info, result)
+		}
+		if requestPriced {
+			return nil, terminalError
+		}
+	}
+	return usage, terminalError
+}
