+func TestAudioTranscriptionChatConversionCancellationClosesUpstream(t *testing.T) {
+	c, _, info := audioTranscriptionRequest(t, nil, nil)
+	ctx, cancel := context.WithCancel(c.Request.Context())
+	c.Request = c.Request.WithContext(ctx)
+	entered := make(chan struct{})
+	finished := make(chan struct{})
+	upstream := httptest.NewServer(http.HandlerFunc(func(_ http.ResponseWriter, r *http.Request) {
+		_, _ = io.Copy(io.Discard, r.Body)
+		close(entered)
+		<-r.Context().Done()
+		close(finished)
+	}))
+	defer upstream.Close()
+	info.ChannelBaseUrl = upstream.URL
+	adaptor := &Adaptor{}
+	body, err := adaptor.ConvertAudioRequest(c, info, dto.AudioRequest{Model: "audio-model"})
+	require.NoError(t, err)
+	returned := make(chan error, 1)
+	go func() { _, err := adaptor.DoRequest(c, info, body); returned <- err }()
+	<-entered
+	cancel()
+	require.Error(t, <-returned)
+	<-finished
+}
