+)
+
+func TestNativeTranscriptionUsageBillingUnits(t *testing.T) {
+	const expression = `tier("audio", p * 2 + ai * 5 + c * 3)`
+	for _, tc := range []struct {
+		name, body string
+		want       float64
+		invalid    bool
+	}{
+		{name: "token and singular audio details", body: `{"usage":{"type":"tokens","input_tokens":100,"output_tokens":20,"total_tokens":120,"input_token_details":{"audio_tokens":80,"text_tokens":20}}}`, want: 250},
+		{name: "explicit zero", body: `{"usage":{"type":"tokens","input_tokens":0,"output_tokens":0,"total_tokens":0}}`},
+		{name: "reported seconds", body: `{"usage":{"type":"duration","seconds":30.1}}`, want: 517},
+		{name: "missing usage", body: `{"text":"hello"}`, want: 175},
+		{name: "empty usage", body: `{"usage":{}}`, want: 175},
+		{name: "negative seconds", body: `{"usage":{"type":"duration","seconds":-1}}`, invalid: true},
+		{name: "missing seconds", body: `{"usage":{"type":"duration"}}`, invalid: true},
+		{name: "negative tokens", body: `{"usage":{"type":"tokens","input_tokens":-1,"output_tokens":0,"total_tokens":0}}`, invalid: true},
+		{name: "incomplete token object", body: `{"usage":{"type":"tokens","input_tokens":1}}`, invalid: true},
+		{name: "out of range token counter", body: `{"usage":{"type":"tokens","input_tokens":18446744073709551615,"output_tokens":0,"total_tokens":18446744073709551615}}`, invalid: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, _ := gin.CreateTestContext(httptest.NewRecorder())
+			ctx.Request = httptest.NewRequest("POST", "/v1/audio/transcriptions", nil)
+			info := &relaycommon.RelayInfo{}
+			info.SetEstimatePromptTokens(175)
+			usage, err := transcriptionResponseUsage(ctx, info, []byte(tc.body), "json")
+			if tc.invalid {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			params := service.BuildTieredTokenParams(usage, false, billingexpr.UsedVarsByHash(expression, billingexpr.ExprHashString(expression)))
+			cost, _, err := billingexpr.RunExpr(expression, params)
+			require.NoError(t, err)
+			assert.Equal(t, tc.want, cost/1_000_000*500_000)
+		})
+	}
+}
