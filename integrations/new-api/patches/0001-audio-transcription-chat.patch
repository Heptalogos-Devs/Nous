+// PrepareAudioChatTranscriptionBilling runs before the ordinary reservation.
+// Its estimate describes the prepared Chat request, not native ASR's minute units.
+func PrepareAudioChatTranscriptionBilling(c *gin.Context, info *relaycommon.RelayInfo, request *dto.GeneralOpenAIRequest) *types.NewAPIError {
+	if request == nil || info == nil {
+		return types.NewError(errors.New("audio transcription billing requires a prepared chat request"), types.ErrorCodeInvalidRequest, types.ErrOptionWithSkipRetry())
+	}
+	estimateInfo := *info
+	estimateInfo.Request = request
+	estimateInfo.RelayMode = relayconstant.RelayModeChatCompletions
+	estimateInfo.RelayFormat = types.RelayFormatOpenAI
+	estimate, err := EstimateRequestToken(c, request.GetTokenCountMeta(), &estimateInfo)
+	if err != nil {
+		return types.NewError(err, types.ErrorCodeCountTokenFailed, types.ErrOptionWithSkipRetry())
+	}
+
+	form, err := common.ParseMultipartFormReusable(c)
+	if err != nil {
+		return types.NewError(err, types.ErrorCodeInvalidRequest, types.ErrOptionWithSkipRetry())
+	}
+	defer form.RemoveAll()
+	parameters := map[string]any{"model": info.GetOriginModelName(), "stream": request.IsStream(c.Request)}
+	for _, key := range []string{"language", "prompt", "response_format"} {
+		if values := form.Value[key]; len(values) == 1 {
+			parameters[key] = values[0]
+		}
+	}
+	if request.Temperature != nil {
+		parameters["temperature"] = *request.Temperature
+	}
+	body, err := common.Marshal(parameters)
+	if err != nil {
+		return types.NewError(err, types.ErrorCodeInvalidRequest, types.ErrOptionWithSkipRetry())
+	}
+	info.BillingRequestInput = &billingexpr.RequestInput{Body: body, Headers: info.RequestHeaders}
+	c.Set(transcriptionBillingContextKey, &transcriptionBillingState{
+		owner: info, chat: request, promptEstimate: estimate, backend: "audio_chat",
+	})
+	return nil
+}
