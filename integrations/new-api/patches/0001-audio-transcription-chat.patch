+type audioTranscriptionState struct{ responseFormat string }
+
+const preparedAudioTranscriptionKey = "advanced_custom_audio_transcription_chat"
+
+type preparedAudioTranscription struct {
+	chat           *dto.GeneralOpenAIRequest
+	responseFormat string
+}
+
+// PrepareAudioTranscriptionBilling runs before reservation only for an explicit audio-to-Chat route.
+func PrepareAudioTranscriptionBilling(c *gin.Context, info *relaycommon.RelayInfo, request dto.Request) *types.NewAPIError {
+	if info.RelayFormat != types.RelayFormatOpenAIAudio || info.RelayMode != relayconstant.RelayModeAudioTranscription || common.GetContextKeyInt(c, constant.ContextKeyChannelType) != constant.ChannelTypeAdvancedCustom {
+		return nil
+	}
+	settings, ok := common.GetContextKeyType[dto.ChannelOtherSettings](c, constant.ContextKeyChannelOtherSetting)
+	if !ok {
+		return nil
+	}
+	route, matched := settings.AdvancedCustom.MatchPathForModel(c.Request.URL.Path, info.OriginModelName)
+	if !matched || route.Converter != dto.AdvancedCustomConverterAudioTranscriptionToChat {
+		return nil
+	}
+	audio, ok := request.(*dto.AudioRequest)
+	if !ok {
+		return types.NewError(errors.New(i18n.T(c, i18n.MsgDistributorInvalidRequest, map[string]any{"Error": "invalid audio transcription request"})), types.ErrorCodeInvalidRequest, types.ErrOptionWithStatusCode(http.StatusBadRequest), types.ErrOptionWithSkipRetry())
+	}
+	chat, err := PrepareAudioTranscriptionChat(c, info, audio)
+	if err != nil {
+		return types.NewError(errors.New(i18n.T(c, i18n.MsgDistributorInvalidRequest, map[string]any{"Error": err.Error()})), types.ErrorCodeInvalidRequest, types.ErrOptionWithStatusCode(http.StatusBadRequest), types.ErrOptionWithSkipRetry())
+	}
+	return service.PrepareAudioChatTranscriptionBilling(c, info, chat)
+}
+
+// PrepareAudioTranscriptionChat materializes the same request used for reservation and execution.
+// Channel metadata is resolved on a copy so controller's initial selected-channel path remains intact.
+func PrepareAudioTranscriptionChat(c *gin.Context, info *relaycommon.RelayInfo, request *dto.AudioRequest) (*dto.GeneralOpenAIRequest, error) {
+	if cached, ok := c.Get(preparedAudioTranscriptionKey); ok {
+		return cached.(*preparedAudioTranscription).chat, nil
+	}
+	form, err := common.ParseMultipartFormReusable(c)
+	if err != nil {
+		return nil, err
+	}
+	defer form.RemoveAll()
+	allowed := map[string]bool{"model": true, "language": true, "prompt": true, "temperature": true, "response_format": true, "stream": true}
+	for name, values := range form.Value {
+		if !allowed[name] || len(values) != 1 {
+			return nil, fmt.Errorf("unsupported transcription parameter %q or repeated scalar values", name)
+		}
+	}
+	files := form.File["file"]
+	if len(files) != 1 || len(form.File) != 1 {
+		return nil, errors.New("exactly one audio file is required")
+	}
+	get := func(name string) string {
+		if values := form.Value[name]; len(values) > 0 {
+			return values[0]
+		}
+		return ""
+	}
+	metadata := *info
+	if info.ChannelMeta == nil {
+		metadata.InitChannelMeta(c)
+	} else {
+		channelMeta := *info.ChannelMeta
+		metadata.ChannelMeta = &channelMeta
+	}
+	audio := *request
+	if err = helper.ModelMappedHelper(c, &metadata, &audio); err != nil {
+		return nil, err
+	}
+	input := &dto.AudioTranscriptionInput{Model: audio.Model, Audio: dto.MessageInputAudio{Format: strings.ToLower(strings.TrimPrefix(filepath.Ext(files[0].Filename), "."))}, Language: get("language"), Prompt: get("prompt"), ResponseFormat: audio.ResponseFormat}
+	if input.ResponseFormat == "" {
+		input.ResponseFormat = "json"
+	}
+	if value := get("stream"); value != "" {
+		input.Stream, err = strconv.ParseBool(value)
+		if err != nil {
+			return nil, errors.New("stream must be a boolean")
+		}
+	}
+	if value := get("temperature"); value != "" {
+		number, parseErr := strconv.ParseFloat(value, 64)
+		if parseErr != nil {
+			return nil, errors.New("invalid transcription temperature")
+		}
+		input.Temperature = &number
+	}
+	file, err := files[0].Open()
+	if err != nil {
+		return nil, err
+	}
+	data, readErr := io.ReadAll(file)
+	file.Close()
+	if readErr != nil {
+		return nil, readErr
+	}
+	input.Audio.Data = base64.StdEncoding.EncodeToString(data)
+	result, err := service.ConvertRequestByID(c, &metadata, relayconvert.ConverterAudioTranscriptionToOpenAIChat, input)
+	if err != nil {
+		return nil, err
+	}
+	chat, ok := result.Value.(*dto.GeneralOpenAIRequest)
+	if !ok {
+		return nil, errors.New("audio transcription converter returned an invalid chat request")
+	}
+	c.Set(preparedAudioTranscriptionKey, &preparedAudioTranscription{chat: chat, responseFormat: input.ResponseFormat})
+	info.IsStream = input.Stream
+	return chat, nil
+}
+
+func (a *Adaptor) convertAudioTranscriptionChat(c *gin.Context, info *relaycommon.RelayInfo, request dto.AudioRequest) (body io.Reader, err error) {
+	defer func() {
+		if err != nil {
+			err = types.NewError(errors.New(i18n.T(c, i18n.MsgDistributorInvalidRequest, map[string]any{"Error": err.Error()})), types.ErrorCodeInvalidRequest, types.ErrOptionWithStatusCode(http.StatusBadRequest), types.ErrOptionWithSkipRetry())
+		}
+	}()
+	prepared, err := PrepareAudioTranscriptionChat(c, info, &request)
+	if err != nil {
+		return nil, err
+	}
+	cached, _ := c.Get(preparedAudioTranscriptionKey)
+	a.audioTranscription = &audioTranscriptionState{responseFormat: cached.(*preparedAudioTranscription).responseFormat}
+	chat, err := common.DeepCopy(prepared)
+	if err != nil {
+		return nil, err
+	}
+	// Retries reuse the audio and task while applying that attempt's mapped model.
+	chat.Model = request.Model
+	info.IsStream = chat.IsStream(c.Request)
+	info.AppendRequestConversion(types.RelayFormatOpenAI)
+	converted, err := a.convertOpenAICompatibleRequest(c, info, chat)
+	if err != nil {
+		return nil, err
+	}
+	payload, err := common.Marshal(converted)
+	if err != nil {
+		return nil, err
+	}
+	if len(info.ParamOverride) > 0 {
+		payload, err = relaycommon.ApplyParamOverrideWithRelayInfo(payload, info)
+		if err != nil {
+			return nil, err
+		}
+		var effective dto.GeneralOpenAIRequest
+		if err = common.Unmarshal(payload, &effective); err != nil {
+			return nil, err
+		}
+		expectedMessages, _ := common.Marshal(chat.Messages)
+		actualMessages, _ := common.Marshal(effective.Messages)
+		var expectedValue, actualValue any
+		_ = common.Unmarshal(expectedMessages, &expectedValue)
+		_ = common.Unmarshal(actualMessages, &actualValue)
+		if !reflect.DeepEqual(expectedValue, actualValue) || effective.Model != chat.Model || effective.IsStream(c.Request) != info.IsStream || len(effective.Tools) > 0 {
+			return nil, errors.New("channel overrides must preserve the transcription task, model and stream mode")
+		}
+		if helper.ExceedsMaxTokensLimit(effective.MaxTokens, effective.MaxCompletionTokens) {
+			return nil, errors.New("channel override max tokens exceeds the supported limit")
+		}
+	}
+	return bytes.NewReader(payload), nil
+}
+
+func transcriptionResponseError(c *gin.Context, message string) *types.NewAPIError {
+	return types.NewOpenAIError(errors.New(i18n.T(c, "audio.transcription_response_invalid", map[string]any{"Error": message})), types.ErrorCodeBadResponseBody, http.StatusBadGateway, types.ErrOptionWithSkipRetry())
+}
+
+// Downstream transcription usage uses the audio API's token names; billing keeps the original usage.
+func transcriptionUsage(usage *dto.Usage) gin.H {
+	if usage == nil {
+		return nil
+	}
+	result := gin.H{"type": "tokens", "input_tokens": usage.PromptTokens, "output_tokens": usage.CompletionTokens, "total_tokens": usage.TotalTokens}
+	if audio := usage.PromptTokensDetails.AudioTokens; audio > 0 {
+		result["input_token_details"] = gin.H{"audio_tokens": audio}
+	}
+	return result
+}
+
+func (a *Adaptor) doAudioTranscriptionChatResponse(c *gin.Context, response *http.Response, info *relaycommon.RelayInfo) (any, *types.NewAPIError) {
+	defer service.CloseResponseBodyGracefully(response)
+	c.Header("X-Transcription-Backend", "audio-chat")
+	if info.IsStream {
+		return a.streamAudioTranscriptionChat(c, response, info)
+	}
+	var decoded struct {
+		dto.OpenAITextResponse
+		ReportedUsage json.RawMessage `json:"usage"`
+	}
+	if err := common.DecodeJson(response.Body, &decoded); err != nil {
+		return nil, transcriptionResponseError(c, "invalid audio-chat transcription response")
+	}
+	reported, usageErr := service.ParseAudioChatTranscriptionUsage(decoded.ReportedUsage)
+	if usageErr != nil {
+		return nil, transcriptionResponseError(c, usageErr.Error())
+	}
+	info.ObserveResponseModel(decoded.Model)
+	if upstream := decoded.GetOpenAIError(); upstream != nil && upstream.Type != "" {
+		return service.FinalizeAudioChatTranscriptionUsage(c, info, reported, "", types.WithOpenAIError(*upstream, response.StatusCode))
+	}
+	text := ""
+	if len(decoded.Choices) == 1 {
+		text = decoded.Choices[0].Message.StringContent()
+	}
+	if len(decoded.Choices) != 1 || decoded.Choices[0].FinishReason != "stop" || len(decoded.Choices[0].Message.ParseToolCalls()) != 0 {
+		return service.FinalizeAudioChatTranscriptionUsage(c, info, reported, text, transcriptionResponseError(c, "audio-chat transcription did not finish normally"))
+	}
+	settled, terminalError := service.FinalizeAudioChatTranscriptionUsage(c, info, reported, text, nil)
+	if terminalError != nil {
+		return settled, terminalError
+	}
+	if a.audioTranscription.responseFormat == "text" {
+		c.Data(http.StatusOK, "text/plain; charset=utf-8", []byte(text))
+	} else {
+		body := gin.H{"text": text, "model": decoded.Model, "transcription_backend": "audio_chat"}
+		if reported != nil {
+			body["usage"] = transcriptionUsage(settled)
+		}
+		c.JSON(http.StatusOK, body)
+	}
+	return settled, nil
+}
+
+func (a *Adaptor) streamAudioTranscriptionChat(c *gin.Context, response *http.Response, info *relaycommon.RelayInfo) (*dto.Usage, *types.NewAPIError) {
+	var text strings.Builder
+	var usage *dto.Usage
+	finished := false
+	var failure *types.NewAPIError
+	helper.StreamScannerHandler(c, response, info, func(data string, result *helper.StreamResult) {
+		var event struct {
+			dto.ChatCompletionsStreamResponse
+			ReportedUsage json.RawMessage `json:"usage"`
+			Error         any             `json:"error"`
+		}
+		if err := common.Unmarshal([]byte(data), &event); err != nil {
+			failure = transcriptionResponseError(c, "invalid audio-chat transcription stream")
+			result.Stop(failure)
+			return
+		}
+		if upstream := dto.GetOpenAIError(event.Error); upstream != nil && upstream.Type != "" {
+			failure = types.WithOpenAIError(*upstream, http.StatusBadGateway)
+			result.Stop(failure)
+			return
+		}
+		info.ObserveResponseModel(event.Model)
+		frameUsage, usageErr := service.ParseAudioChatTranscriptionUsage(event.ReportedUsage)
+		if usageErr != nil {
+			failure = transcriptionResponseError(c, usageErr.Error())
+			result.Stop(failure)
+			return
+		}
+		if frameUsage != nil {
+			usage = frameUsage
+		}
+		for _, choice := range event.Choices {
+			if choice.Index != 0 || len(choice.Delta.ToolCalls) != 0 {
+				failure = transcriptionResponseError(c, "audio-chat transcription returned multiple outputs or tools")
+				result.Stop(failure)
+				return
+			}
+			if choice.FinishReason != nil && *choice.FinishReason != "" {
+				if *choice.FinishReason != "stop" {
+					failure = transcriptionResponseError(c, "audio-chat transcription was interrupted or filtered")
+					result.Stop(failure)
+					return
+				}
+				finished = true
+				info.StreamStatus.MarkCompleted()
+			}
+			if delta := choice.Delta.GetContentString(); delta != "" {
+				text.WriteString(delta)
+				if err := helper.ObjectData(c, gin.H{"type": "transcript.text.delta", "delta": delta}); err != nil {
+					result.Stop(err)
+					return
+				}
+			}
+		}
+	})
+	info.StreamStatus.RequireTerminal()
+	if c.Request.Context().Err() != nil {
+		info.StreamStatus.MarkCancelled()
+		return service.FinalizeAudioChatTranscriptionUsage(c, info, usage, text.String(), nil)
+	}
+	if failure != nil {
+		return service.FinalizeAudioChatTranscriptionUsage(c, info, usage, text.String(), failure)
+	}
+	if !finished || info.StreamStatus.HasErrors() {
+		return service.FinalizeAudioChatTranscriptionUsage(c, info, usage, text.String(), transcriptionResponseError(c, "audio-chat transcription stream ended before completion"))
+	}
+	settled, terminalError := service.FinalizeAudioChatTranscriptionUsage(c, info, usage, text.String(), nil)
+	if terminalError != nil {
+		return settled, terminalError
+	}
+	info.StreamStatus.MarkCompleted()
+	event := gin.H{"type": "transcript.text.done", "text": text.String(), "transcription_backend": "audio_chat"}
+	if usage != nil {
+		event["usage"] = transcriptionUsage(settled)
+	}
+	if err := helper.ObjectData(c, event); err != nil {
+		return service.FinalizeAudioChatTranscriptionUsage(c, info, usage, text.String(), types.NewError(err, types.ErrorCodeDoRequestFailed, types.ErrOptionWithSkipRetry()))
+	}
+	return settled, nil
+}
