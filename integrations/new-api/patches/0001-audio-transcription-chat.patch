+// ValidateAudioTranscriptionSeconds bounds measured durations before the native
+// ASR convention converts them to billing-equivalent prompt units.
+func ValidateAudioTranscriptionSeconds(seconds float64) error {
+	if math.IsNaN(seconds) || math.IsInf(seconds, 0) || seconds < 0 {
+		return errors.New("invalid upstream transcription duration")
+	}
+	return nil
+}
