+func TestAudioTranscriptionChatConversionStreamCompletionAndInterruption(t *testing.T) {
+	previousTimeout := constant.StreamingTimeout
+	constant.StreamingTimeout = 5
+	t.Cleanup(func() { constant.StreamingTimeout = previousTimeout })
+	for _, tc := range []struct {
+		name     string
+		complete bool
+		usage    string
+	}{
+		{"complete", true, `{"prompt_tokens":4,"completion_tokens":1,"total_tokens":5}`},
+		{"complete_alias_usage", true, `{"input_tokens":4,"output_tokens":1,"total_tokens":5}`},
+		{"interrupted", false, ""},
+	} {
+		complete := tc.complete
+		t.Run(tc.name, func(t *testing.T) {
+			c, recorder, info := audioTranscriptionRequest(t, map[string]string{"stream": "true"}, nil)
+			adaptor := &Adaptor{}
+			_, err := adaptor.ConvertAudioRequest(c, info, dto.AudioRequest{Model: "audio-model"})
+			require.NoError(t, err)
+			body := "data: {\"model\":\"audio-model\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Nous\"}}]}\n\n"
+			if complete {
+				body += "data: {\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}],\"usage\":" + tc.usage + "}\n\ndata: [DONE]\n\n"
+			}
+			usage, apiErr := adaptor.DoResponse(c, &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": []string{"text/event-stream"}}, Body: io.NopCloser(strings.NewReader(body))}, info)
+			require.Contains(t, recorder.Body.String(), "transcript.text.delta")
+			if complete {
+				require.Nil(t, apiErr)
+				require.Contains(t, recorder.Body.String(), "transcript.text.done")
+				require.Contains(t, recorder.Body.String(), `"input_tokens":4`)
+				require.Contains(t, recorder.Body.String(), `"output_tokens":1`)
+				require.Equal(t, 5, usage.(*dto.Usage).TotalTokens)
+			} else {
+				require.NotNil(t, apiErr)
+				require.NotContains(t, recorder.Body.String(), "transcript.text.done")
+			}
+		})
+	}
+}
