+func audioTranscriptionRequest(t *testing.T, fields map[string]string, audio []byte) (*gin.Context, *httptest.ResponseRecorder, *relaycommon.RelayInfo) {
+	t.Helper()
+	require.NoError(t, i18n.Init())
+	var body bytes.Buffer
+	form := multipart.NewWriter(&body)
+	require.NoError(t, form.WriteField("model", "audio-model"))
+	for name, value := range fields {
+		require.NoError(t, form.WriteField(name, value))
+	}
+	part, err := form.CreateFormFile("file", "voice.WAV")
+	require.NoError(t, err)
+	if audio == nil {
+		audio = []byte("RIFFtestWAVE")
+	}
+	_, err = part.Write(audio)
+	require.NoError(t, err)
+	require.NoError(t, form.Close())
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/audio/transcriptions", &body)
+	c.Request.Header.Set("Content-Type", form.FormDataContentType())
+
+	info := &relaycommon.RelayInfo{
+		RelayMode: relayconstant.RelayModeAudioTranscription, RelayFormat: types.RelayFormatOpenAIAudio,
+		RequestURLPath: "/v1/audio/transcriptions", OriginModelName: "audio-model",
+		ChannelMeta: &relaycommon.ChannelMeta{
+			ApiKey: "integration-test-key", ChannelType: constant.ChannelTypeAdvancedCustom,
+			UpstreamModelName: "audio-model", ChannelOtherSettings: dto.ChannelOtherSettings{
+				AdvancedCustom: &dto.AdvancedCustomConfig{Routes: []dto.AdvancedCustomRoute{{IncomingPath: "/v1/audio/transcriptions", UpstreamPath: "/v1/chat/completions", Converter: dto.AdvancedCustomConverterAudioTranscriptionToChat}}},
+			},
+		},
+	}
+	return c, recorder, info
+}
