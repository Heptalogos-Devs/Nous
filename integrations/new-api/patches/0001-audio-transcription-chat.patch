+// CheckAudioTranscriptionBillingRoute freezes the unit contract across channel
+// retries: native ASR duration units and Chat tokens require distinct routes.
+func CheckAudioTranscriptionBillingRoute(c *gin.Context, info *relaycommon.RelayInfo) *types.NewAPIError {
+	if info.RelayMode != relayconstant.RelayModeAudioTranscription {
+		return nil
+	}
+	backend := "native_asr"
+	if common.GetContextKeyInt(c, constant.ContextKeyChannelType) == constant.ChannelTypeAdvancedCustom {
+		settings, ok := common.GetContextKeyType[dto.ChannelOtherSettings](c, constant.ContextKeyChannelOtherSetting)
+		if ok {
+			route, matched := settings.AdvancedCustom.MatchPathForModel(c.Request.URL.Path, info.GetOriginModelName())
+			if matched && route.Converter == dto.AdvancedCustomConverterAudioTranscriptionToChat {
+				backend = "audio_chat"
+			}
+		}
+	}
+	state := transcriptionBillingStateFor(c, info)
+	if state == nil && backend == "native_asr" {
+		c.Set(transcriptionBillingContextKey, &transcriptionBillingState{owner: info, backend: backend})
+		return nil
+	}
+	if state == nil || state.backend != backend {
+		return types.NewErrorWithStatusCode(errors.New("audio transcription channel retry would change billing units"), types.ErrorCodeModelPriceError, http.StatusBadRequest, types.ErrOptionWithSkipRetry())
+	}
+	return nil
+}
