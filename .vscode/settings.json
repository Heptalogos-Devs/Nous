{
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  },
  "rust-analyzer.linkedProjects": ["Cargo.toml"],
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.cargo.targetDir": "temp/build/rust-analyzer",
  "rust-analyzer.server.extraEnv": {
    "CARGO_HOME": "${workspaceFolder}/temp/cache/cargo",
    "TEMP": "${workspaceFolder}/temp/runtime",
    "TMP": "${workspaceFolder}/temp/runtime",
    "TMPDIR": "${workspaceFolder}/temp/runtime"
  },
  "files.watcherExclude": {
    "**/temp/cache/**": true,
    "**/temp/build/**": true,
    "**/temp/runtime/**": true,
    "**/temp/repos/**": true
  },
  "search.exclude": {
    "**/temp/cache/**": true,
    "**/temp/build/**": true,
    "**/temp/runtime/**": true
  }
}
