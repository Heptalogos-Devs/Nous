{
  "python.defaultInterpreterPath": "${workspaceFolder}/temp/venvs/python-native",
  "python.languageServer": "None",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests/python", "native/python/tests"],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  },
  "rust-analyzer.linkedProjects": ["native/Cargo.toml"],
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.checkOnSave": true,
  "rust-analyzer.cargo.extraEnv": {
    "CARGO_TARGET_DIR": "${workspaceFolder}/temp/build/native"
  },
  "files.watcherExclude": {
    "**/temp/**": true,
    "**/.venv/**": true,
    "**/target/**": true
  }
}
